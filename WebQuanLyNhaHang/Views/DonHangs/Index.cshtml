@model WebQuanLyNhaHang.ViewModel.OrdersIndexViewModel
@using System.Globalization
@{
    Layout = null;
    var culture = CultureInfo.GetCultureInfo("vi-VN");

    string FormatCurrency(decimal value) => $"{value.ToString("N0", culture)}đ";
    string FormatDateTime(DateTime? value) => value.HasValue
        ? value.Value.ToString("dd/MM/yyyy HH:mm", culture)
        : "Chưa có thời gian";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đơn mang về</title>
    <link rel="icon" type="image/svg+xml" href="~/assets/images/admin-favicon.svg" asp-append-version="true" />
    <link rel="shortcut icon" href="~/assets/images/admin-favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/admin-orders.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-app">
        @await Html.PartialAsync("_AdminSidebar")

        <button class="mobile-nav-backdrop" id="mobile-nav-backdrop" type="button" aria-label="Đóng menu" hidden></button>

        <div class="main-shell">
            <header class="topbar topbar--orders">
                <button class="icon-button mobile-nav-trigger" id="mobile-nav-trigger" type="button" aria-label="Mở menu" aria-controls="dashboard-sidebar" aria-expanded="false">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    </svg>
                </button>

                <div class="topbar__meta">
                    <p class="topbar__eyebrow">Quản lý đơn mang về</p>
                    <div class="topbar__heading">
                        <h1>Danh sách đơn online</h1>
                        <p>Theo dõi từng đơn giao hàng, người nhận, địa chỉ và trạng thái xử lý.</p>
                    </div>
                </div>

                <div class="topbar__actions">
                    <button class="icon-button notification-button" type="button" aria-label="Thông báo">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M15 17H5.6a1 1 0 0 1-.8-1.6L6 14V10a6 6 0 1 1 12 0v4l1.2 1.4a1 1 0 0 1-.8 1.6H15ZM10 20a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        <span class="notification-dot"></span>
                    </button>

                    <div class="account-menu">
                        <button class="account-trigger" id="account-trigger" type="button" aria-expanded="false">
                            <span class="account-trigger__avatar">@Model.Initials</span>
                            <span class="account-trigger__copy">
                                <strong>@Model.AdminDisplayName</strong>
                                <small>@Model.AdminAccount</small>
                            </span>
                            <span class="account-trigger__chevron" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                            </span>
                        </button>

                        <div class="account-dropdown" id="account-dropdown" hidden>
                            <div class="account-dropdown__header">
                                <strong>@Model.AdminDisplayName</strong>
                                <span>@Model.AdminAccount</span>
                            </div>
                            <a class="account-dropdown__item" href="@Url.Action("Index", "Admin")">Dashboard tổng quan</a>
                            <a class="account-dropdown__item" href="@Url.Action("Index", "Products")">Danh sách sản phẩm</a>
                            <a class="account-dropdown__item is-danger" href="@Url.Action("Logout", "Admin")">Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </header>

            <main class="dashboard-scroll">
                <div class="orders-page">
                    <section class="order-filter-card" aria-label="Bộ lọc đơn hàng">
                        <div class="order-search">
                            <svg viewBox="0 0 24 24" fill="none">
                                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
                                <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                            </svg>
                            <input type="search" data-order-search placeholder="Tìm theo mã đơn, người nhận, SĐT, địa chỉ..." />
                        </div>

                        <label class="order-select">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                            </svg>
                            <select data-order-status-filter aria-label="Lọc theo trạng thái">
                                <option value="">Tất Cả</option>
                                <option value="pending">Chờ xác nhận</option>
                                <option value="preparing">Đang chuẩn bị</option>
                                <option value="shipping">Đang giao</option>
                                <option value="delivered">Đã giao</option>
                                <option value="cancelled">Đã hủy</option>
                            </select>
                        </label>

                        <label class="order-date-filter">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="2"></rect>
                                <path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                            </svg>
                            <span>Chọn Ngày</span>
                            <input type="date" data-order-date-filter aria-label="Lọc theo ngày" />
                        </label>

                        <button class="order-export-button" type="button" data-export-orders>
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M12 3v12M8 11l4 4 4-4M4 19h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                            Xuất Excel
                        </button>
                    </section>

                    <section class="order-table-card">
                        <div class="order-table-wrap">
                            <table class="order-table" data-orders-table>
                                <thead>
                                    <tr>
                                        <th>Mã ĐH</th>
                                        <th>Người nhận</th>
                                        <th>Địa chỉ giao</th>
                                        <th>Thời gian đặt</th>
                                        <th class="is-right">Tổng Tiền</th>
                                        <th>Thanh Toán</th>
                                        <th>Trạng Thái</th>
                                        <th class="is-right"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Orders)
                                    {
                                        <tr data-order-row data-search="@item.SearchText" data-status="@item.StatusKey" data-date="@item.DateValue">
                                            <td data-label="Mã ĐH">
                                                <strong class="order-code">@item.OrderCode</strong>
                                            </td>
                                            <td data-label="Người nhận">
                                                <div class="order-customer">
                                                    <strong>@item.CustomerName</strong>
                                                    <span>@item.CustomerPhone</span>
                                                </div>
                                            </td>
                                            <td data-label="Địa chỉ giao" class="order-address">@item.CustomerAddress</td>
                                            <td data-label="Thời gian đặt" class="order-time">@FormatDateTime(item.OrderTime)</td>
                                            <td data-label="Tổng Tiền" class="is-right order-total">@FormatCurrency(item.TotalAmount)</td>
                                            <td data-label="Thanh Toán">
                                                <span class="payment-pill">@item.PaymentLabel</span>
                                            </td>
                                            <td data-label="Trạng Thái">
                                                <span class="order-status @item.StatusCssClass">@item.StatusLabel</span>
                                            </td>
                                            <td class="is-right" data-label="Chi Tiết">
                                                <button class="order-detail-button" type="button" data-order-detail-url="@Url.Action("DetailsDataV2", "DonHangs", new { id = item.OrderId })">
                                                    <svg viewBox="0 0 24 24" fill="none">
                                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="2"></path>
                                                        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"></circle>
                                                    </svg>
                                                    Chi Tiết
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="order-empty-row" data-empty-row hidden>
                                        <td colspan="8">Không tìm thấy đơn online phù hợp với bộ lọc hiện tại.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
            </main>
        </div>
    </div>

    <div class="order-detail-modal" id="order-detail-modal" hidden aria-hidden="true">
        <button class="order-detail-modal__backdrop" type="button" data-order-modal-close aria-label="Đóng chi tiết đơn hàng"></button>

        <section class="order-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="order-detail-title">
            <button class="order-detail-close" type="button" data-order-modal-close aria-label="Đóng">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
            </button>

            <header class="order-detail-header">
                <span class="order-detail-status" data-detail-status>Đang tải</span>
                <h2 id="order-detail-title" data-detail-code>Chi tiết đơn hàng</h2>
                <p data-detail-created-time>Đang tải thông tin đơn hàng...</p>
            </header>

            <div class="order-detail-loading" data-detail-loading>
                <span class="order-detail-spinner"></span>
                <span>Đang tải chi tiết đơn hàng...</span>
            </div>

            <div class="order-detail-error" data-detail-error hidden>
                Không tải được chi tiết đơn hàng. Vui lòng thử lại.
            </div>

            <div class="order-detail-content" data-detail-content hidden>
                <div class="order-detail-status-actions" data-detail-status-actions hidden></div>

                <div class="order-detail-summary">
                    <article>
                        <span>Khách hàng</span>
                        <strong data-detail-customer>Khách lẻ</strong>
                        <small data-detail-phone>Chưa có SĐT</small>
                    </article>
                    <article>
                        <span>Giao hàng</span>
                        <strong data-detail-table>Giao hàng</strong>
                        <small data-detail-address>Chưa có địa chỉ</small>
                    </article>
                    <article>
                        <span>Thanh toán</span>
                        <strong data-detail-payment>Chưa thanh toán</strong>
                        <small data-detail-promotion>Không áp dụng</small>
                    </article>
                    <article>
                        <span>Nhân viên</span>
                        <strong data-detail-employee>Chưa phân công</strong>
                        <small data-detail-time-range>Chưa có thời gian</small>
                    </article>
                </div>

                <div class="order-detail-items">
                    <div class="order-detail-items__head">
                        <h3>Sản phẩm trong đơn</h3>
                        <span data-detail-item-count>0 món</span>
                    </div>

                    <div class="order-detail-items__table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody data-detail-items></tbody>
                        </table>
                    </div>
                </div>

                <div class="order-detail-total">
                    <span>Tổng tiền</span>
                    <strong data-detail-total>0đ</strong>
                </div>
            </div>
        </section>
    </div>

    <script src="~/assets/js/admin-orders.js" asp-append-version="true"></script>
    <script src="~/assets/js/admin-service-notifications.js" asp-append-version="true"></script>
</body>
</html>
