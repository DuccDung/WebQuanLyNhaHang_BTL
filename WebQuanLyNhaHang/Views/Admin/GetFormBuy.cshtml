@using System.Globalization
@model List<WebQuanLyNhaHang.ViewModel.CTDH_Product>
@{
    var viVn = CultureInfo.GetCultureInfo("vi-VN");
    var banId = Model.FirstOrDefault()?.BanId ?? (int?)ViewBag.BanId;
    var tableCode = banId.HasValue ? $"Bàn {banId.Value}" : "Bàn";
    var total = Model.Sum(x => x.ThanhTien ?? 0);
    var customerGroups = Model
        .GroupBy(item => item.CustomerGroupKey ?? item.DhId?.ToString() ?? "guest")
        .Select(group => new
        {
            Name = group.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.CustomerName))?.CustomerName ?? "Khách tại bàn",
            Items = group.ToList()
        })
        .ToList();
    string Money(decimal? value) => string.Format(viVn, "{0:N0} đ", value ?? 0);
}

<style>
    #component-FormBuy .overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        visibility: hidden;
        opacity: 0;
        background: rgba(15, 23, 42, .45);
        backdrop-filter: blur(8px);
        transition: opacity .25s ease, visibility .25s ease;
    }

    #component-FormBuy .overlay.visible {
        visibility: visible;
        opacity: 1;
    }

    #component-FormBuy .container-buy {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 1001;
        width: min(92vw, 920px);
        max-height: 88vh;
        overflow: auto;
        visibility: hidden;
        opacity: 0;
        transform: translate(-50%, -48%) scale(.98);
        border: 1px solid #e1e7ef;
        border-radius: 22px;
        background: #fff;
        padding: 28px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .26);
        color: #1f2937;
        transition: opacity .25s ease, visibility .25s ease, transform .25s ease;
    }

    #component-FormBuy .container-buy.visible {
        visibility: visible;
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    #component-FormBuy .buy-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
    }

    #component-FormBuy .buy-title {
        margin: 0 0 8px;
        color: #111827;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.2;
    }

    #component-FormBuy .buy-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
    }

    #component-FormBuy .buy-meta span {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #f8fafc;
        padding: 0 10px;
    }

    #component-FormBuy .buy-total-card {
        min-width: 190px;
        border: 1px solid #fed7aa;
        border-radius: 14px;
        background: #fff7ed;
        padding: 12px 14px;
        text-align: right;
    }

    #component-FormBuy .buy-total-card span {
        display: block;
        color: #9a3412;
        font-size: 12px;
        font-weight: 500;
    }

    #component-FormBuy .buy-total-card strong {
        display: block;
        margin-top: 4px;
        color: #ea580c;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.2;
    }

    #component-FormBuy .invoice-table-wrap {
        overflow: hidden;
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        background: #fff;
    }

    #component-FormBuy .invoice-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    #component-FormBuy .invoice-table th,
    #component-FormBuy .invoice-table td {
        border-right: 1px solid #dbe4f0;
        border-bottom: 1px solid #dbe4f0;
        padding: 13px 14px;
        color: #1f2937;
        font-size: 14px;
        line-height: 1.35;
        vertical-align: middle;
    }

    #component-FormBuy .invoice-table th:last-child,
    #component-FormBuy .invoice-table td:last-child {
        border-right: 0;
    }

    #component-FormBuy .invoice-table thead th {
        background: #f1f5f9;
        color: #334155;
        font-weight: 700;
        white-space: nowrap;
    }

    #component-FormBuy .invoice-table tbody tr:nth-child(even) {
        background: #fbfdff;
    }

    #component-FormBuy .invoice-customer-row td {
        border-right: 0;
        background: #fff7ed;
        color: #c2410c;
        font-weight: 700;
    }

    #component-FormBuy .invoice-customer-row__label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    #component-FormBuy .invoice-customer-row__label::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: #ff5a00;
    }

    #component-FormBuy .invoice-table tfoot td {
        border-bottom: 0;
        background: #fff7ed;
        color: #111827;
        font-weight: 700;
    }

    #component-FormBuy .is-center {
        text-align: center;
    }

    #component-FormBuy .is-money,
    #component-FormBuy .is-right {
        text-align: right;
        white-space: nowrap;
    }

    #component-FormBuy .payment-method-panel {
        margin-top: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #f8fafc;
        padding: 14px;
    }

    #component-FormBuy .payment-method-panel__title {
        margin: 0 0 10px;
        color: #111827;
        font-size: 15px;
        font-weight: 600;
    }

    #component-FormBuy .payment-methods {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    #component-FormBuy .payment-method {
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 46px;
        border: 1px solid #dbe4f0;
        border-radius: 12px;
        background: #fff;
        padding: 0 12px;
        color: #334155;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

    #component-FormBuy .payment-method:has(input:checked) {
        border-color: #ff8a3d;
        background: #fff7ed;
        color: #ea580c;
        box-shadow: 0 8px 20px rgba(255, 90, 0, .08);
    }

    #component-FormBuy .payment-method input {
        accent-color: #ff5a00;
    }

    #component-FormBuy .btn-right {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    #component-FormBuy .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        border-radius: 12px;
        padding: 0 18px;
        border: 1px solid #d8e1ed;
        background: #fff;
        color: #344256;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    #component-FormBuy .btn-pay {
        border-color: #ff5a00;
        background: #ff5a00;
        color: #fff;
    }

    #component-FormBuy .btn-print {
        border-color: #fed7aa;
        background: #fff7ed;
        color: #c2410c;
    }

    #component-FormBuy .notification-box {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 1002;
        width: min(90vw, 430px);
        visibility: hidden;
        opacity: 0;
        transform: translate(-50%, -48%) scale(.98);
        border-radius: 18px;
        background: #fff;
        padding: 24px;
        text-align: center;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .26);
        transition: opacity .25s ease, visibility .25s ease, transform .25s ease;
    }

    #component-FormBuy .notification-box.visible {
        visibility: visible;
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    #component-FormBuy .success-icon {
        color: #16a34a;
        font-size: 44px;
        margin-bottom: 12px;
    }

    #component-FormBuy .invoice-brand,
    #component-FormBuy .invoice-print-footer {
        display: none;
    }

    @@media print {
        @@page {
            size: A4;
            margin: 14mm;
        }

        html,
        body {
            width: auto !important;
            min-width: 0 !important;
            background: #fff !important;
        }

        body > * {
            display: none !important;
        }

        #component-FormBuy,
        #component-FormBuy-success {
            display: block !important;
            position: static !important;
            width: 100% !important;
            min-height: 0 !important;
        }

        #component-FormBuy .overlay,
        #component-FormBuy .btn-right,
        #component-FormBuy .notification-box,
        #component-FormBuy .payment-method-panel {
            display: none !important;
        }

        #component-FormBuy .container-buy {
            position: static !important;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            width: 148mm !important;
            max-height: none !important;
            overflow: visible !important;
            transform: none !important;
            margin: 0 auto !important;
            border: 1px solid #d7dde6 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            padding: 10mm !important;
            color: #111827 !important;
            font-family: Arial, "Helvetica Neue", sans-serif !important;
        }

        #component-FormBuy .container-buy * {
            visibility: visible !important;
            color-adjust: exact !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        #component-FormBuy #invoicePrintArea {
            display: block !important;
        }

        #component-FormBuy .invoice-brand {
            display: block !important;
            margin-bottom: 7mm;
            padding-bottom: 5mm;
            border-bottom: 2px solid #111827;
            text-align: center;
        }

        #component-FormBuy .invoice-brand__name {
            margin: 0;
            color: #111827 !important;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        #component-FormBuy .invoice-brand__subtitle {
            margin: 3px 0 0;
            color: #4b5563 !important;
            font-size: 12px;
        }

        #component-FormBuy .buy-header {
            display: block !important;
            margin-bottom: 6mm;
        }

        #component-FormBuy .buy-title {
            margin: 0 0 4mm !important;
            color: #111827 !important;
            font-size: 18px !important;
            font-weight: 800 !important;
            text-align: center;
            text-transform: uppercase;
        }

        #component-FormBuy .buy-meta {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 6px 12px !important;
            margin-bottom: 5mm;
            color: #111827 !important;
            font-size: 12px !important;
        }

        #component-FormBuy .buy-meta span {
            min-height: 0 !important;
            border: 0 !important;
            border-radius: 0 !important;
            background: transparent !important;
            padding: 0 !important;
            color: #111827 !important;
        }

        #component-FormBuy .buy-meta span::before {
            content: "";
        }

        #component-FormBuy .buy-total-card {
            min-width: 0 !important;
            border: 1px solid #111827 !important;
            border-radius: 0 !important;
            background: #f8fafc !important;
            padding: 4mm !important;
            text-align: center !important;
        }

        #component-FormBuy .buy-total-card span {
            color: #374151 !important;
            font-size: 11px !important;
            font-weight: 700 !important;
            text-transform: uppercase;
        }

        #component-FormBuy .buy-total-card strong {
            margin-top: 2mm !important;
            color: #111827 !important;
            font-size: 24px !important;
            font-weight: 800 !important;
        }

        #component-FormBuy .invoice-table-wrap {
            border: 0 !important;
            border-radius: 0 !important;
        }

        #component-FormBuy .invoice-table {
            border-collapse: collapse !important;
        }

        #component-FormBuy .invoice-table th,
        #component-FormBuy .invoice-table td {
            border: 0 !important;
            border-bottom: 1px dashed #9ca3af !important;
            padding: 7px 4px !important;
            color: #111827 !important;
            font-size: 12px !important;
            line-height: 1.35 !important;
        }

        #component-FormBuy .invoice-table thead th {
            border-top: 1px solid #111827 !important;
            border-bottom: 1px solid #111827 !important;
            background: transparent !important;
            color: #111827 !important;
            font-weight: 800 !important;
        }

        #component-FormBuy .invoice-table tbody tr:nth-child(even) {
            background: transparent !important;
        }

        #component-FormBuy .invoice-customer-row td {
            border-top: 1px solid #111827 !important;
            border-bottom: 1px solid #111827 !important;
            background: #f8fafc !important;
            color: #111827 !important;
            font-size: 12px !important;
            font-weight: 800 !important;
        }

        #component-FormBuy .invoice-customer-row__label::before {
            background: #111827 !important;
        }

        #component-FormBuy .invoice-table tfoot td {
            border-top: 2px solid #111827 !important;
            border-bottom: 0 !important;
            background: transparent !important;
            color: #111827 !important;
            font-size: 13px !important;
            font-weight: 800 !important;
        }

        #component-FormBuy .invoice-print-footer {
            display: block !important;
            margin-top: 8mm;
            padding-top: 5mm;
            border-top: 1px solid #111827;
            text-align: center;
        }

        #component-FormBuy .invoice-print-footer p {
            margin: 0 0 3px;
            color: #111827 !important;
            font-size: 12px;
            font-weight: 700;
        }

        #component-FormBuy .invoice-print-footer small {
            color: #4b5563 !important;
            font-size: 11px;
        }
    }

    @@media (max-width: 720px) {
        #component-FormBuy .buy-header {
            display: grid;
        }

        #component-FormBuy .buy-total-card {
            text-align: left;
        }

        #component-FormBuy .payment-methods {
            grid-template-columns: 1fr;
        }
    }
</style>

<main id="component-FormBuy-success">
    <div class="overlay"></div>

    <section class="container-buy" aria-label="Bảng thanh toán">
        <div id="invoicePrintArea">
            <div class="invoice-brand" aria-hidden="true">
                <p class="invoice-brand__name">Nhà hàng Cloudy</p>
                <p class="invoice-brand__subtitle">Hóa đơn thanh toán tại quán</p>
            </div>

            <header class="buy-header">
                <div>
                    <h1 class="buy-title">Bảng Thanh Toán</h1>
                    <div class="buy-meta">
                        <span>@tableCode</span>
                        <span>@DateTime.Now.ToString("HH:mm dd/MM/yyyy", viVn)</span>
                        <span data-payment-print-label>Thanh toán: Tiền mặt</span>
                    </div>
                </div>
                <div class="buy-total-card">
                    <span>Tổng thanh toán</span>
                    <strong>@Money(total)</strong>
                </div>
            </header>

            <div class="invoice-table-wrap">
                <table class="invoice-table">
                    <colgroup>
                        <col style="width: 56px;">
                        <col>
                        <col style="width: 110px;">
                        <col style="width: 150px;">
                        <col style="width: 170px;">
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="is-center">STT</th>
                            <th>Tên sản phẩm</th>
                            <th class="is-center">Số lượng</th>
                            <th class="is-money">Đơn giá</th>
                            <th class="is-money">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody data-banid="@banId">
                        @{
                            var rowIndex = 1;
                        }
                        @foreach (var customerGroup in customerGroups)
                        {
                            <tr class="invoice-customer-row">
                                <td colspan="5">
                                    <span class="invoice-customer-row__label">Người gọi: @customerGroup.Name</span>
                                </td>
                            </tr>

                            foreach (var item in customerGroup.Items)
                            {
                                <tr>
                                    <td class="is-center">@(rowIndex++)</td>
                                    <td>@item.TenSanPham</td>
                                    <td class="is-center">@((item.SoLuong ?? 0).ToString("N0", viVn))</td>
                                    <td class="is-money">@Money(item.DonGia)</td>
                                    <td class="is-money">@Money(item.ThanhTien)</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4">Thành tiền</td>
                            <td class="is-money">@Money(total)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <footer class="invoice-print-footer" aria-hidden="true">
                <p>Cảm ơn quý khách. Hẹn gặp lại!</p>
                <small>Vui lòng kiểm tra hóa đơn trước khi rời quầy.</small>
            </footer>
        </div>

        <section class="payment-method-panel" aria-label="Phương thức thanh toán">
            <p class="payment-method-panel__title">Phương thức thanh toán</p>
            <div class="payment-methods">
                <label class="payment-method">
                    <input type="radio" name="adminPaymentMethod" value="cash" data-label="Tiền mặt" checked>
                    <span>Tiền mặt</span>
                </label>
                <label class="payment-method">
                    <input type="radio" name="adminPaymentMethod" value="card" data-label="Thẻ ngân hàng">
                    <span>Thẻ ngân hàng</span>
                </label>
                <label class="payment-method">
                    <input type="radio" name="adminPaymentMethod" value="wallet" data-label="Ứng dụng điện thoại">
                    <span>Ứng dụng điện thoại</span>
                </label>
            </div>
        </section>

        <div class="btn-right">
            <button type="button" class="btn btn-pay" onclick="submitPayment()">Thanh toán</button>
            <button type="button" class="btn btn-print" onclick="printInvoice()">In hóa đơn</button>
            <button type="button" class="btn" onclick="hideTable()">Đóng</button>
        </div>
    </section>

    <div class="notification-box" id="successMessage">
        <i class="fas fa-check-circle success-icon"></i>
        <h2>Thanh toán thành công</h2>
        <p>Hóa đơn đã được gửi đến máy in của trình duyệt.</p>
        <button class="btn btn-pay" onclick="continueShopping()">Tiếp tục</button>
    </div>

    <script>
        (function () {
            const root = document.getElementById("component-FormBuy-success");
            const container = root.querySelector(".container-buy");
            const overlay = root.querySelector(".overlay");
            const successMessage = root.querySelector("#successMessage");

            window.setTimeout(function () {
                container.classList.add("visible");
                overlay.classList.add("visible");
            }, 0);

            window.hideTable = function () {
                container.classList.remove("visible");
                overlay.classList.remove("visible");
            };

            window.getSelectedPaymentMethod = function () {
                return root.querySelector("input[name='adminPaymentMethod']:checked");
            };

            window.syncPaymentPrintLabel = function () {
                const selected = window.getSelectedPaymentMethod();
                const label = selected ? selected.getAttribute("data-label") : "Tiền mặt";
                const printLabel = root.querySelector("[data-payment-print-label]");

                if (printLabel) {
                    printLabel.textContent = "Thanh toán: " + label;
                }

                return {
                    value: selected ? selected.value : "cash",
                    label: label
                };
            };

            root.querySelectorAll("input[name='adminPaymentMethod']").forEach(function (input) {
                input.addEventListener("change", window.syncPaymentPrintLabel);
            });

            window.printInvoice = function () {
                window.syncPaymentPrintLabel();
                window.print();
            };

            window.submitPayment = function () {
                const banId = root.querySelector("tbody").getAttribute("data-banid");
                const paymentMethod = window.syncPaymentPrintLabel();

                $.ajax({
                    url: "/Admin/ProcessPayment",
                    type: "GET",
                    data: {
                        BanId: banId,
                        paymentMethod: paymentMethod.value
                    },
                    success: function () {
                        window.printInvoice();
                        container.classList.remove("visible");
                        successMessage.classList.add("visible");
                        overlay.classList.add("visible");
                    },
                    error: function (error) {
                        console.error("Lỗi khi xử lý thanh toán:", error);
                        alert("Có lỗi xảy ra khi xử lý thanh toán. Vui lòng thử lại.");
                    }
                });
            };

            window.continueShopping = function () {
                successMessage.classList.remove("visible");
                overlay.classList.remove("visible");
                location.reload();
            };
        })();
    </script>
</main>
