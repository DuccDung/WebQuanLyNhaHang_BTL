@using Microsoft.AspNetCore.Http
@model WebQuanLyNhaHang.ViewModel.ViewModelMenu  // Đón class ViewModel đển nhận dữ liệu sử lý
@{
    int? DhId = Context.Session.GetInt32("DhId");
    int? BanId = Context.Session.GetInt32("BanId");
    string? dineInCustomerId = Context.Session.GetString("DineInCustomerId");
}
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="~/assets/images/admin-favicon.svg" asp-append-version="true" />
    <link rel="shortcut icon" href="~/assets/images/admin-favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebQuanLyTuXa.styles.css" asp-append-version="true" />


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet"
          href="~/asset/font/fontawesome-free-6.5.2-web/fontawesome-free-6.5.2-web/css/all.min.css">

    <link rel="stylesheet" href="~/asset/css/base.css">
    <link rel="stylesheet" href="~/asset/css/responsive.css">
    <link rel="stylesheet" type="text/css" href="btl.css">
    <link rel="stylesheet" href="~/WebQuanLyNhaHang.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asset/css/menu.css">
    <style>
        body.local-menu-page {
            background: #fff;
        }

        .local-menu-reveal {
            opacity: 0;
            transform: translateY(12px);
            transition: opacity .42s ease, transform .42s ease;
            transition-delay: var(--menu-delay, 0ms);
        }

        body.local-menu-ready .local-menu-reveal {
            opacity: 1;
            transform: translateY(0);
        }

        .header__menu-inner,
        .menu__category-nav {
            opacity: 0;
            transform: translateY(-8px);
            transition: opacity .36s ease, transform .36s ease;
        }

        body.local-menu-ready .header__menu-inner,
        body.local-menu-ready .menu__category-nav {
            opacity: 1;
            transform: translateY(0);
        }

        .menu-list {
            transition: opacity .36s ease, transform .36s ease, box-shadow .2s ease;
        }

        .menu-list.local-menu-reveal {
            transform: translateY(10px);
        }

        body.local-menu-ready .menu-list.local-menu-reveal {
            transform: translateY(0);
        }

        .menu-item {
            transition: transform .18s ease;
        }

        .menu-item:active {
            transform: scale(.99);
        }

        .foodter {
            opacity: 0;
            transform: translateY(14px);
            transition: opacity .36s ease .24s, transform .36s ease .24s;
        }

        body.local-menu-ready .foodter {
            opacity: 1;
            transform: translateY(0);
        }

        .ordered-dinein-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 22px;
            margin-top: 7px;
            padding: 0 8px;
            border-radius: 999px;
            background: #fff2e0;
            color: #f7941e;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .menu__product-plus {
            width: 58px;
            text-align: right;
            vertical-align: middle;
        }

        .menu-search-empty {
            display: grid;
            justify-items: center;
            gap: 8px;
            margin: 22px 8px 90px;
            padding: 34px 20px;
            border-radius: 12px;
            background: #fff;
            color: #777;
            text-align: center;
            box-shadow: 0 8px 26px rgba(0, 0, 0, .08);
        }

        .menu-search-empty i {
            color: #f7941e;
            font-size: 24px;
        }

        .menu-search-empty__title {
            color: #222;
            font-size: 18px;
            font-weight: 600;
        }

        .menu-search-empty__text {
            max-width: 260px;
            font-size: 14px;
            line-height: 1.45;
        }

        #content.is-searching {
            opacity: .58;
            pointer-events: none;
        }
    </style>
    <title>Kính chào quý khách</title>
</head>
<body class="local-menu-page">
    <div class="app__menu">
        <div class="header__menu-inner" style="position:fixed; top:0; left:0; right:0; z-index:1000;">
            <a asp-controller="Home" asp-action="Service">
                   <div class="call-staff--mini-home">
                <i class="fa-solid fa-house"></i>
            </div>
            </a>
            <div class="search-area animation">
                <div class="header-area__search-form">
                    <div class="header-area__search-form--inner">
                        <div class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                        <input type="text" id="txtSearchBox" placeholder="Bạn muốn tìm món gì ?" class="input-text--search">
                    </div>
                </div>
            </div>
        </div>
        <div class="menu__category-nav">
            @await Component.InvokeAsync("Category")
        </div>
        <div class="" style="position:fixed; top:0; right:0; left:0; height:50px; background-color:#fff; z-index: 20;"></div>
        <div class="container__menu local-menu-reveal" id="content" style="margin-top: 90px; --menu-delay: 110ms;">

            @foreach (var category in Model.Categories())
            {
                <div id="@category.CateId" class="label-container local-menu-reveal">
                    @category.TenLoaiSanPham
                </div>

                foreach (var product in Model.FindProductByCate(category.CateId))
                {
                    var submittedQuantity = Model.CountSubmittedDineInProduct(BanId, dineInCustomerId, product.ProductId);
                    <div class="menu-list local-menu-reveal">
                        <table>
                            <tr class="menu-item">
                                <td class="menu__product-img" style="width:10px">
                                    <div class="product__item-img"
                                         style="background-image: url(@product.PathPhoto);">
                                    </div>
                                </td>
                                <td class="menu__product-name">
                                    <div>@product.TenSanPham</div>
                                    <div class="menu__product-price" style="text-align: left; color:orange;">
                                        @String.Format("{0:N0}", product.GiaTien)đ
                                    </div>
                                    @if (submittedQuantity > 0)
                                    {
                                        <div class="ordered-dinein-badge">Đã gọi @submittedQuantity</div>
                                    }
                                </td>
                               
                                <td class="menu__product-plus">
                                    @* @if(Model.CountProductDetail(DhId ,product.ProductId) != 0){
                                        @await Component.InvokeAsync("MenuItemEdit", new { ProductId = product.ProductId, DhId = DhId })
                                    }
                                    else
                                    {
                                         <a asp-controller="Home" asp-action="ProductDetail" asp-route-ProductID="@product.ProductId"><button>+</button></a>
                                    } *@
                                    @await Component.InvokeAsync("MenuAddSub", new { ProductId = product.ProductId, DhId = DhId }) @* component +- *@
                                </td>
                            </tr>
                        </table>
                    </div>
                }
            }
        </div>
        @{
            int soluong = Model.CountProductDetail(DhId); // đếm số lượng của chi tiết hóa đơn
            @if (soluong != 0)
            {
                <div class="app__menu">
                    <a asp-controller="Home" asp-action="Cart" asp-route-DhId="DhId">
                        <div class="foodter">
                            <div class="foodter__icon-left foodter__icon">
                                <i class="fa-solid fa-cart-plus"></i>
                            </div>
                            <div class="foodter__content">Xem giỏ hàng(@soluong món)</div>
                            <div class="foodter__icon-right foodter__icon">
                                <i class="fa-solid fa-angle-right"></i>
                            </div>
                        </div>
                </a>
                </div>
            }
        }
    </div>
    <script src="~/js/scripts.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function prepareMenuReveal(scope) {
            const root = scope || document;
            const elements = Array.from(root.querySelectorAll(".label-container, .menu-list"));
            elements.forEach(function (element, index) {
                element.classList.add("local-menu-reveal");
                element.style.setProperty("--menu-delay", Math.min(360, 40 + index * 24) + "ms");
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            prepareMenuReveal(document);
            requestAnimationFrame(function () {
                document.body.classList.add("local-menu-ready");
            });
        });

        function scrollToCategory(categoryId) {
            // Lấy phần tử của danh mục cần cuộn tới
            const targetElement = document.getElementById(categoryId);

            // Lấy chiều cao của thanh điều hướng cố định
            const navHeight = document.querySelector('.menu__category-nav').offsetHeight + document.querySelector('.header__menu-inner').offsetHeight;
            // Tính toán vị trí cần cuộn tới, bù thêm khoảng cách tương ứng với chiều cao của thanh điều hướng
            const scrollPosition = targetElement.offsetTop - navHeight;

            // Cuộn đến vị trí tính toán
            window.scrollTo({
                top: scrollPosition,
                behavior: 'smooth'
            });
        }

        // chức năng tìm kiếm trong trang menu 
        $(document).ready(function () {
            $(document).on('click', '.menu__product-plus > a', function () {
                $(this).addClass('is-loading');
            });

            const $content = $("div#content");
            const originalMenuHtml = $content.html();
            let searchTimer = null;
            let searchRequest = null;
            let searchVersion = 0;

            function refreshMenuReveal() {
                const content = document.getElementById("content");
                if (!content) {
                    return;
                }

                prepareMenuReveal(content);
                document.body.classList.remove("local-menu-ready");
                requestAnimationFrame(function () {
                    document.body.classList.add("local-menu-ready");
                });
            }

            function normalizeClientSearch(value) {
                return (value || "").replace(/\s+/g, " ").trim();
            }

            function restoreFullMenu() {
                if (searchRequest) {
                    searchRequest.abort();
                    searchRequest = null;
                }

                searchVersion++;
                $content.removeClass("is-searching").html(originalMenuHtml);
                refreshMenuReveal();
            }

            $('#txtSearchBox').on('input', function () {
                const txtsearch = normalizeClientSearch($(this).val());
                clearTimeout(searchTimer);

                if (!txtsearch) {
                    restoreFullMenu();
                    return;
                }

                searchTimer = setTimeout(function () {
                    const currentVersion = ++searchVersion;

                    if (searchRequest) {
                        searchRequest.abort();
                    }

                    $content.addClass("is-searching");
                    searchRequest = $.ajax({
                        url: '@Url.Action("GetName", "Home")',
                        data: { txtsearch: txtsearch },
                        success: function (response) {
                            if (currentVersion !== searchVersion) {
                                return;
                            }

                            $content.html(response);
                            refreshMenuReveal();
                        },
                        error: function (xhr, status) {
                            if (status !== "abort") {
                                $content.html('<div class="menu-search-empty"><i class="fa-solid fa-triangle-exclamation"></i><div class="menu-search-empty__title">Chưa tìm được món</div><div class="menu-search-empty__text">Bạn thử nhập lại sau một chút nhé.</div></div>');
                                refreshMenuReveal();
                            }
                        },
                        complete: function () {
                            if (currentVersion === searchVersion) {
                                $content.removeClass("is-searching");
                            }
                        }
                    });
                }, 240);
            });
        });

    </script>
</body>
</html>
