        line-height: 1.45;
    }

    .review-actions {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 182px;
        gap: 12px;
    }

    .review-phone-wrap {
        position: relative;
    }

    .review-phone-wrap i {
        position: absolute;
        top: 50%;
        left: 15px;
        color: #b8b8b8;
        transform: translateY(-50%);
    }

    .review-phone {
        width: 100%;
        height: 54px;
        padding: 0 12px 0 42px;
        border: 1px solid #f0f0f0;
        border-radius: 8px;
        background: #f8f8f8;
        color: #303030;
        font-size: 15px;
        outline: none;
    }

    .review-submit {
        height: 54px;
        border: 0;
        border-radius: 9px;
        background: #ff9418;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        transition: background-color .18s ease, transform .18s ease;
    }

    .review-submit:active {
        transform: translateY(1px);
        background: #f08300;
    }

    .review-toast {
        display: none;
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #ecfdf3;
        color: #15803d;
        font-size: 13px;
        line-height: 1.35;
    }

    .review-toast.is-visible {
        display: block;
    }

    @@media (max-width: 380px) {
        .review-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<body class="service-page">

    <div class="container custom-padding service-reveal" style="--reveal-delay: 40ms;">
        <div class="service-shop-header">
            <div class="service-shop-header__info">
                <h1 class="service-shop-header__name">O2O Coffee - Chùa Láng</h1>
                <p class="service-shop-header__address">
                    <i class="fa-solid fa-location-dot service-shop-header__pin" aria-hidden="true"></i>
                    <span class="service-shop-header__address-text">137 Chùa Láng, Láng Thượng, Đống Đa, Hà Nội, Việt Nam</span>
                </p>
            </div>
            <button type="button" class="service-language-button" aria-label="Ngôn ngữ tiếng Việt">
                <span class="service-language-button__flag">★</span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <div class="container custom-padding">
        <div class="row service-reveal" style="--reveal-delay: 110ms;">
            <div class="col-12 text-center">
                <!-- Carousel bắt đầu -->
                <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="1500">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="/asset/img/imgWeb/1688720502417_image_o2o.jpg" alt="Banner 1"
                                 class="img-fluid banner-img">
                        </div>
                    </div>

                </div>
                <!-- Carousel kết thúc -->
            </div>
        </div>

        <div class="row service-reveal" style="--reveal-delay: 180ms;">
            <div class="col-12">
                <div class="service-greeting">
                    <h1 class="service-greeting__title">
                        <img class="service-greeting__icon" src="@greetingIcon" alt="">
                        <span>@greetingText <span class="service-greeting__name">@displayCustomerName</span></span>
                        <i class="fa-solid fa-pen service-greeting__edit" aria-hidden="true"></i>
                    </h1>
                    <p class="service-greeting__subtitle">
                        <span>Chúng tôi sẽ trả đồ cho bạn tại bàn:</span>
                        <span class="service-greeting__table">@tableCode</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="row service-reveal" style="--reveal-delay: 220ms;">
            <div class="col-12">
                <a href="#" class="point-login-button" aria-label="Nhập số điện thoại để tích điểm">
                    <img class="point-login-button__image" src="/asset/img/imgWeb/img-request-login.png" alt="">
                    <span class="point-login-button__text">Nhập số điện thoại để tích điểm</span>
                    <img class="point-login-button__next" src="/asset/img/imgWeb/next-icon.svg" alt="">
                </a>
            </div>
        </div>

        <div class="row my-3 justify-content-between service-reveal gx-2" style="--reveal-delay: 250ms;">
            <div class="col-4 col-md-4 col-lg-4 mb-2 d-flex justify-content-center">
                <div class="card-custom card fixed-size service-soft-card" data-bs-toggle="modal" data-bs-target="#paymentModal">
                    <h5 class="service-action-title">Gọi thanh toán</h5>
                    <img class="service-action-image service-action-image--payment" src="/asset/img/imgWeb/request_payment_2.png" alt="">
                </div>
            </div>
            <div class="col-4 col-md-4 col-lg-4 mb-2 d-flex justify-content-center">
                <div class="card-custom card fixed-size service-soft-card" data-bs-toggle="modal" data-bs-target="#requestModal">
                    <h5 class="service-action-title">Gọi nhân viên</h5>
                    <img class="service-action-image service-action-image--staff" src="/asset/img/imgWeb/bg-request_service.png" alt="">
                </div>
            </div>
            <div class="col-4 col-md-4 col-lg-4 mb-2 d-flex justify-content-center">
                <div class="card-custom card fixed-size service-soft-card" data-bs-toggle="modal" data-bs-target="#reviewModal">
                    <h5 class="service-action-title">Đánh giá</h5>
                    <img class="service-action-image service-action-image--rate" src="/asset/img/imgWeb/bg-rate.png" alt="">
                </div>
            </div>
        </div>


        <div class="row mt-2 mb-3 service-reveal" style="--reveal-delay: 320ms;">
            <div class="col-12">
                <a asp-controller="Home" asp-action="Menu" class="service-menu-button" aria-label="Xem Menu - Gọi món">
                    <span class="service-menu-button__text">Xem Menu - Gọi món</span>
                    <span class="service-menu-button__arrow"><i class="fa-solid fa-chevron-right"></i></span>
                </a>
            </div>
        </div>

        <div class="submitted-orders service-reveal" style="--reveal-delay: 390ms;">
            <div class="submitted-orders__title">
                <h2>Các món đã gọi</h2>
                @if (submittedItems.Any())
                {
                    <span>@submittedItems.Sum(item => item.SoLuong ?? 0) món - @String.Format("{0:N0}", submittedTotal)đ</span>
                }
            </div>
            @if (submittedItems.Any())
            {
                <div class="submitted-orders__list">
                    @foreach (var item in submittedItems)
                    {
                        <div class="submitted-order-item">
                            <div class="submitted-order-item__image" style="background-image: url(@item.PathPhoto);"></div>
                            <div class="submitted-order-item__body">
                                <p class="submitted-order-item__name">@item.TenSanPham</p>
                                @if (!string.IsNullOrWhiteSpace(item.Condition))
                                {
                                    <p class="submitted-order-item__note">@item.Condition</p>
                                }
                            </div>
                            <div class="submitted-order-item__meta">
                                <span>x@(item.SoLuong ?? 0)</span>
                                <span>@String.Format("{0:N0}", item.ThanhTien ?? 0)đ</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="submitted-orders__empty">
                    Bạn chưa gửi món nào. Hãy vào menu để chọn món và gửi yêu cầu gọi món.
                </div>
            }
        </div>

        <!-- Modal cho Gọi thanh toán -->
        <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
            <div class="modal-dialog payment-bottom-modal modal-dialog-bottom">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="paymentModalLabel">Gọi thanh toán</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="payment-sheet__subtitle">Bạn muốn thanh toán bằng ?</p>
                        <div class="payment-methods">
                            <label class="payment-method">
                                <input type="radio" name="paymentMethod" value="cash">
                                <span class="payment-method__icon">
                                    <img src="/asset/img/imgWeb/cash.svg" alt="">
                                </span>
                                <span class="payment-method__name">Tiền mặt</span>
                                <span class="payment-method__radio"></span>
                            </label>
                            <label class="payment-method">
                                <input type="radio" name="paymentMethod" value="card" checked>
                                <span class="payment-method__icon">
                                    <img src="/asset/img/imgWeb/card_02.svg" alt="">
                                </span>
                                <span class="payment-method__name">Thẻ ngân hàng</span>
                                <span class="payment-method__radio"></span>
                            </label>
                            <label class="payment-method">
                                <input type="radio" name="paymentMethod" value="wallet">
                                <span class="payment-method__icon">
                                    <img src="/asset/img/imgWeb/app.svg" alt="">
                                </span>
                                <span class="payment-method__name">Ứng dụng điện thoại</span>
                                <span class="payment-method__radio"></span>
                            </label>
                        </div>
                        <button type="button" class="payment-sheet__submit" id="sendPaymentRequest">Gửi yêu cầu</button>
                        <div class="payment-request-toast" id="paymentRequestToast">
                            Đã gửi yêu cầu thanh toán. Nhân viên sẽ đến hỗ trợ bạn.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal cho Gọi nhân viên -->
        <div class="modal fade" id="requestModal" tabindex="-1" aria-labelledby="requestModalLabel" aria-hidden="true">
            <div class="modal-dialog request-bottom-modal modal-dialog-bottom">
                <div class="modal-content">
                    <div class="request-sheet">
                        <div class="request-sheet__handle"></div>
                        <h5 class="request-sheet__title" id="requestModalLabel">Gọi nhân viên</h5>
                        <p class="request-sheet__subtitle">Bạn muốn yêu cầu nhân viên làm gì?</p>
                        <div class="request-input-wrap">
                            <i class="fa-solid fa-pen"></i>
                            <textarea class="request-sheet__input" id="requestInput" rows="2"></textarea>
                        </div>
                        <button type="button" class="request-sheet__submit" id="sendStaffRequest">Gửi yêu cầu</button>
                        <div class="request-toast" id="staffRequestToast">
                            Đã gửi yêu cầu. Nhân viên sẽ đến hỗ trợ bạn.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal cho Đánh giá -->
        <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
            <div class="modal-dialog review-bottom-modal modal-dialog-bottom">
                <div class="modal-content">
                    <div class="review-sheet">
                        <div class="review-sheet__handle"></div>
                        <button type="button" class="review-sheet__close" data-bs-dismiss="modal" aria-label="Close">×</button>
                        <div class="review-panel">
                            <h5 class="review-sheet__title" id="reviewModalLabel">Trải nghiệm của bạn ở nhà hàng hôm nay thế nào?</h5>
                            <div class="review-stars" id="reviewStars">
                                <button type="button" class="review-star is-active" data-value="1">★</button>
                                <button type="button" class="review-star is-active" data-value="2">★</button>
                                <button type="button" class="review-star is-active" data-value="3">★</button>
                                <button type="button" class="review-star" data-value="4">★</button>
                                <button type="button" class="review-star" data-value="5">★</button>
                            </div>
                            <p class="review-rating-label" id="reviewRatingLabel">Bình thường</p>
                            <div class="review-divider"></div>
                            <p class="review-section-title">Bạn có điều gì chưa hài lòng phải không?</p>
                            <div class="review-tags" id="reviewTags">
                                <button type="button" class="review-tag">Vệ sinh không sạch sẽ</button>
                                <button type="button" class="review-tag">Nhân viên không nhiệt tình</button>
                                <button type="button" class="review-tag">Món ăn không ngon</button>
                                <button type="button" class="review-tag">Món ăn phục vụ lâu</button>
                                <button type="button" class="review-tag">Giá không phù hợp với chất lượng</button>
                                <button type="button" class="review-tag">Không gian bất tiện</button>
                                <button type="button" class="review-tag">Không gian ồn</button>
                            </div>
                            <textarea class="review-comment" id="reviewComment" placeholder="Viết góp ý cho nhà hàng..."></textarea>
                        </div>
                        <div class="review-foot">
                            <p class="review-foot__text">Nhà hàng rất trân trọng và mong muốn phản hồi lại đánh giá trên, bạn vui lòng để lại số điện thoại nhé</p>
                            <div class="review-actions">
                                <div class="review-phone-wrap">
                                    <i class="fa-solid fa-phone"></i>
                                    <input class="review-phone" id="reviewPhone" type="tel" placeholder="Số điện thoại của bạn">
                                </div>
                                <button type="button" class="review-submit" id="sendReview">Gửi đánh giá</button>
                            </div>
                            <div class="review-toast" id="reviewToast">
                                Cảm ơn bạn đã gửi đánh giá.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            requestAnimationFrame(function () {
                document.body.classList.add("service-ready");
            });

            const sendPaymentRequest = document.getElementById("sendPaymentRequest");
            const paymentRequestToast = document.getElementById("paymentRequestToast");
            const paymentModalEl = document.getElementById("paymentModal");
            const paymentModal = paymentModalEl ? bootstrap.Modal.getOrCreateInstance(paymentModalEl) : null;
            const sendStaffRequest = document.getElementById("sendStaffRequest");
            const staffRequestToast = document.getElementById("staffRequestToast");
            const requestInput = document.getElementById("requestInput");
            const requestModalEl = document.getElementById("requestModal");
            const requestModal = requestModalEl ? bootstrap.Modal.getOrCreateInstance(requestModalEl) : null;
            const reviewModalEl = document.getElementById("reviewModal");
            const reviewModal = reviewModalEl ? bootstrap.Modal.getOrCreateInstance(reviewModalEl) : null;
            const reviewStars = Array.from(document.querySelectorAll(".review-star"));
            const reviewRatingLabel = document.getElementById("reviewRatingLabel");
            const reviewTags = Array.from(document.querySelectorAll(".review-tag"));
            const sendReview = document.getElementById("sendReview");
            const reviewToast = document.getElementById("reviewToast");
            const reviewComment = document.getElementById("reviewComment");
            const reviewPhone = document.getElementById("reviewPhone");
            const reviewLabels = {
                1: "Rất không hài lòng",
                2: "Không hài lòng",
                3: "Bình thường",
                4: "Hài lòng",
                5: "Rất hài lòng"
            };

            function setReviewRating(value) {
                reviewStars.forEach(function (star) {
                    const starValue = Number(star.dataset.value);
                    star.classList.toggle("is-active", starValue <= value);
                });

                if (reviewRatingLabel) {
                    reviewRatingLabel.textContent = reviewLabels[value] || "Bình thường";
                }
            }

            if (sendPaymentRequest && paymentRequestToast) {
                sendPaymentRequest.addEventListener("click", function () {
                    paymentRequestToast.classList.add("is-visible");
                    sendPaymentRequest.disabled = true;
                    sendPaymentRequest.textContent = "Đã gửi yêu cầu";

                    setTimeout(function () {
                        if (paymentModal) {
                            paymentModal.hide();
                        }
                    }, 850);
                });
            }

            if (paymentModalEl) {
                paymentModalEl.addEventListener("hidden.bs.modal", function () {
                    if (paymentRequestToast) {
                        paymentRequestToast.classList.remove("is-visible");
                    }

                    if (sendPaymentRequest) {
                        sendPaymentRequest.disabled = false;
                        sendPaymentRequest.textContent = "Gửi yêu cầu";
                    }
                });
            }

            if (sendStaffRequest && staffRequestToast) {
                sendStaffRequest.addEventListener("click", function () {
                    staffRequestToast.classList.add("is-visible");
                    sendStaffRequest.disabled = true;
                    sendStaffRequest.textContent = "Đã gửi yêu cầu";

                    setTimeout(function () {
                        if (requestModal) {
                            requestModal.hide();
                        }
                    }, 850);
                });
            }

            if (requestModalEl) {
                requestModalEl.addEventListener("shown.bs.modal", function () {
                    if (requestInput) {
                        requestInput.focus();
                    }
                });

                requestModalEl.addEventListener("hidden.bs.modal", function () {
                    if (staffRequestToast) {
                        staffRequestToast.classList.remove("is-visible");
                    }

                    if (sendStaffRequest) {
                        sendStaffRequest.disabled = false;
                        sendStaffRequest.textContent = "Gửi yêu cầu";
                    }

                    if (requestInput) {
                        requestInput.value = "";
                    }
                });
            }

            reviewStars.forEach(function (star) {
                star.addEventListener("click", function () {
                    setReviewRating(Number(star.dataset.value));
                });
            });

            reviewTags.forEach(function (tag) {
                tag.addEventListener("click", function () {
                    tag.classList.toggle("is-selected");
                });
            });

            if (sendReview && reviewToast) {
                sendReview.addEventListener("click", function () {
                    reviewToast.classList.add("is-visible");
                    sendReview.disabled = true;
                    sendReview.textContent = "Đã gửi";

                    setTimeout(function () {
                        if (reviewModal) {
                            reviewModal.hide();
                        }
                    }, 900);
                });
            }

            if (reviewModalEl) {
                reviewModalEl.addEventListener("hidden.bs.modal", function () {
                    setReviewRating(3);
                    reviewTags.forEach(function (tag) {
                        tag.classList.remove("is-selected");
                    });

                    if (reviewComment) {
                        reviewComment.value = "";
                    }

                    if (reviewPhone) {
                        reviewPhone.value = "";
                    }

                    if (reviewToast) {
                        reviewToast.classList.remove("is-visible");
                    }

                    if (sendReview) {
                        sendReview.disabled = false;
                        sendReview.textContent = "Gửi đánh giá";
                    }
                });
            }
        });
    </script>

</body>

</html>
