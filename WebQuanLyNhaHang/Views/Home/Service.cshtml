<!DOCTYPE html>
@using Microsoft.AspNetCore.Http
@model WebQuanLyNhaHang.ViewModel.ViewModelCart
@{
    int? banId = Context.Session.GetInt32("BanId");
    string? dineInCustomerId = Context.Session.GetString("DineInCustomerId");
    var customerName = Context.Session.GetString("CustomerName")?.Trim();
    var displayCustomerName = string.IsNullOrWhiteSpace(customerName) ? "Quý khách" : customerName;
    var currentHour = DateTime.Now.Hour;
    var isNightTime = currentHour >= 18 || currentHour < 5;
    var greetingText = isNightTime ? "Chào buổi tối" : "Chào buổi sáng";
    var greetingIcon = isNightTime ? "/asset/img/imgWeb/moon.svg" : "/asset/img/imgWeb/icons8-sun.gif";
    var tableCode = banId.HasValue ? $"A{banId.Value}" : "A--";
    var submittedItems = Model?.SubmittedDineInItems(banId, dineInCustomerId) ?? new List<WebQuanLyNhaHang.ViewModel.CTDH_Product>();
    var submittedTotal = submittedItems.Sum(item => item.ThanhTien ?? 0);
}
