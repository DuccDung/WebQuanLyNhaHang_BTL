<html lang="en">

<head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/svg+xml" href="~/assets/images/admin-favicon.svg" asp-append-version="true" />
        <link rel="shortcut icon" href="~/assets/images/admin-favicon.svg" asp-append-version="true" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/WebQuanLyTuXa.styles.css" asp-append-version="true" />

        <link rel="stylesheet" href="~/asset/css/base.css">
        <link rel="stylesheet" href="~/asset/css/home.css">
        <link rel="stylesheet" href="~/asset/css/responsive.css">
        <link rel="stylesheet" type="text/css" href="btl.css">
        <link rel="stylesheet" href="~/asset/css/card.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/asset/font/fontawesome-free-6.5.2-web/fontawesome-free-6.5.2-web/css/all.min.css">
        <title>Kính chào quý khách</title>
</head>

@model WebQuanLyNhaHang.ViewModel.ViewModelCart
@{
    int? DhId = Context.Session.GetInt32("DhId");
    int? BanId = Context.Session.GetInt32("BanId");
    var cartItems = Model.CTHD_PctByDh(DhId);
    var cartTotal = Model.TongtienById(DhId).TongTien ?? 0;
    var hasCartItems = cartItems.Any();
}
<body>
    <div class="foreground" >
        <div class="header__card">
            <div class=" text__cart-title">
                <div>
                    <div>
                        <a asp-controller="Home" asp-action="Menu">
                            <div class="btn-back">
                                <i class="fa-solid fa-chevron-left"></i>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="page-title">
                    Các món đang gọi
                </div>
                <div class="clear-button__container">
                    @if (hasCartItems)
                    {
                        <div class="btn--clear-cart" role="button" tabindex="0">
                            Clear
                        </div>
                    }
                </div>
            </div>
        </div>

        <div id="cart__content_">
            <div class="container__card">
                @if (!hasCartItems)
                {
                    <div class="cart-empty">
                        <h2>Giỏ hàng đang trống</h2>
                        <p>Bạn chưa chọn món nào. Hãy quay lại menu để thêm đồ uống hoặc bánh yêu thích.</p>
                        <a asp-controller="Home" asp-action="Menu">Xem menu</a>
                    </div>
                }
                else
                {
                    @foreach (var item in cartItems)
                    {
                        <div class="bought--item">
                            <div class="item-editor">
                                <div class="item-box">
                                    <div class="item-inner--right">
                                        <div class="card-img" style="background-image: url(@item.PathPhoto);">
                                        </div>
                                        <div class="card-product-info">
                                            <span>
                                                <span style="color: var(--primary--color)">@item.SoLuong x</span> @item.TenSanPham
                                            </span>
                                            <span class="card-product--description">
                                                @item.Condition
                                            </span>
                                            <span class="card-product--price">
                                                @String.Format("{0:N0}", item.ThanhTien)đ
                                            </span>
                                        </div>
                                    </div>
                                    <div class="item-inner--left">
                                        <div class="btn-remove" id="cart__btn-remove" data-id="@item.CthdId" data-name="@item.TenSanPham">
                                            <i class="fa-solid fa-xmark"></i>
                                        </div>
                                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-ProductID="@item.ProductId" asp-route-cthdId="@item.CthdId" class="btn-edit">
                                            <span>edit</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (hasCartItems)
            {
                <div class="card__total-price">
                    <div>Tổng Tiền</div>
                    <div>@String.Format("{0:N0}", cartTotal)đ</div>
                </div>
                <div class="btn-sumbit">
                    <a asp-controller="Home" asp-action="OrderSuccess" class="cart-order-submit">
                        <button class="buy__item outline" style="background-color: rgb(247, 148, 30); height: 44px;">
                            Gửi yêu cầu gọi món
                        </button>
                    </a>
                </div>
            }
        </div>
       

    </div>
    <div class="cart-confirm" id="cartRemoveConfirm" aria-hidden="true">
        <div class="cart-confirm__backdrop" data-confirm-cancel></div>
        <div class="cart-confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="cartRemoveConfirmTitle">
            <div class="cart-confirm__message" id="cartRemoveConfirmTitle">
                Bạn có chắc muốn loại bỏ sản phẩm này khỏi giỏ hàng của mình không?
            </div>
            <div class="cart-confirm__actions">
                <button type="button" class="cart-confirm__button cart-confirm__button--cancel" data-confirm-cancel>Không</button>
                <button type="button" class="cart-confirm__button cart-confirm__button--agree" data-confirm-agree>Đồng ý</button>
            </div>
        </div>
    </div>
    <div class="cart-confirm" id="cartClearConfirm" aria-hidden="true">
        <div class="cart-confirm__backdrop" data-clear-cancel></div>
        <div class="cart-confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="cartClearConfirmTitle">
            <div class="cart-confirm__message" id="cartClearConfirmTitle">
                Bạn có chắc muốn xóa tất cả sản phẩm trong giỏ hàng của mình không?
            </div>
            <div class="cart-confirm__actions">
                <button type="button" class="cart-confirm__button cart-confirm__button--cancel" data-clear-cancel>Không</button>
                <button type="button" class="cart-confirm__button cart-confirm__button--agree" data-clear-agree>Đồng ý</button>
            </div>
        </div>
    </div>
    <div class="cart-confirm" id="cartOrderConfirm" aria-hidden="true">
        <div class="cart-confirm__backdrop" data-order-cancel></div>
        <div class="cart-confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="cartOrderConfirmTitle">
            <div class="cart-confirm__message" id="cartOrderConfirmTitle">
                Bạn có chắc muốn đặt những món đã chọn không?
            </div>
            <div class="cart-confirm__actions">
                <button type="button" class="cart-confirm__button cart-confirm__button--cancel" data-order-cancel>Không</button>
                <button type="button" class="cart-confirm__button cart-confirm__button--agree" data-order-agree>Đồng ý</button>
            </div>
        </div>
    </div>
    <div class="cart-confirm cart-success" id="cartOrderSuccess" aria-hidden="true">
        <div class="cart-confirm__backdrop"></div>
        <div class="cart-success__dialog" role="dialog" aria-modal="true" aria-labelledby="cartOrderSuccessTitle">
            <div class="cart-success__icon" aria-hidden="true">
                <span></span>
            </div>
            <h2 id="cartOrderSuccessTitle">Gọi món thành công, vui lòng chờ nhân viên ra xác nhận!</h2>
            <div class="cart-success__note">
                Lưu ý: Nếu đợi quá lâu hoặc có thay đổi về món đã gọi bạn có thể dùng chức năng <strong>Gọi nhân viên</strong> ở màn hình chính
            </div>
            <div class="cart-success__actions">
                <button type="button" class="cart-success__button" data-success-ok>Đồng ý</button>
            </div>
        </div>
    </div>
    <!-- Thêm SignalR script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            const confirmModal = $('#cartRemoveConfirm');
            const confirmMessage = $('#cartRemoveConfirmTitle');
            const clearConfirmModal = $('#cartClearConfirm');
            const orderConfirmModal = $('#cartOrderConfirm');
            const orderSuccessModal = $('#cartOrderSuccess');
            let pendingRemove = null;
            let pendingOrderUrl = null;
            let successRedirectUrl = '@Url.Action("Service", "Home")';

            function refreshCartContent(response) {
                const cartContent = $("div#cart__content_");
                cartContent.addClass('is-refreshing');
                setTimeout(function () {
                    cartContent.html(response);
                    syncCartHeaderActions();
                    requestAnimationFrame(function () {
                        cartContent.removeClass('is-refreshing');
                    });
                }, 120);
            }

            function syncCartHeaderActions() {
                const hasItems = $("div#cart__content_ .bought--item").length > 0;
                $('.btn--clear-cart').toggle(hasItems);
            }

            function openRemoveConfirm(removeButton) {
                const productName = removeButton.data('name') || 'sản phẩm này';
                pendingRemove = {
                    id: removeButton.data('id'),
                    item: removeButton.closest('.bought--item')
                };
                confirmMessage.text('Bạn có chắc muốn loại bỏ sản phẩm ' + productName + ' khỏi giỏ hàng của mình không?');
                confirmModal.addClass('is-open').attr('aria-hidden', 'false');
                $('body').addClass('cart-confirm-open');
                setTimeout(function () {
                    $('[data-confirm-agree]').trigger('focus');
                }, 180);
            }

            function closeRemoveConfirm() {
                confirmModal.removeClass('is-open').attr('aria-hidden', 'true');
                $('body').removeClass('cart-confirm-open');
            }

            function openClearConfirm() {
                clearConfirmModal.addClass('is-open').attr('aria-hidden', 'false');
                $('body').addClass('cart-confirm-open');
                setTimeout(function () {
                    $('[data-clear-agree]').trigger('focus');
                }, 180);
            }

            function closeClearConfirm() {
                clearConfirmModal.removeClass('is-open').attr('aria-hidden', 'true');
                $('body').removeClass('cart-confirm-open');
            }

            function openOrderConfirm(orderUrl) {
                pendingOrderUrl = orderUrl;
                orderConfirmModal.addClass('is-open').attr('aria-hidden', 'false');
                $('body').addClass('cart-confirm-open');
                setTimeout(function () {
                    $('[data-order-agree]').trigger('focus');
                }, 180);
            }

            function closeOrderConfirm() {
                orderConfirmModal.removeClass('is-open').attr('aria-hidden', 'true');
                $('body').removeClass('cart-confirm-open');
            }

            function openOrderSuccess() {
                orderSuccessModal.addClass('is-open').attr('aria-hidden', 'false');
                $('body').addClass('cart-confirm-open');
                setTimeout(function () {
                    $('[data-success-ok]').trigger('focus');
                }, 180);
            }

            $(document).on('click', '.btn-remove', function (event) {
                event.preventDefault();
                event.stopImmediatePropagation();
                openRemoveConfirm($(this));
            });

            $(document).on('click', '[data-confirm-cancel]', function () {
                pendingRemove = null;
                closeRemoveConfirm();
            });

            $(document).on('keydown', function (event) {
                if (event.key === 'Escape' && confirmModal.hasClass('is-open')) {
                    pendingRemove = null;
                    closeRemoveConfirm();
                }
                if (event.key === 'Escape' && clearConfirmModal.hasClass('is-open')) {
                    closeClearConfirm();
                }
                if (event.key === 'Escape' && orderConfirmModal.hasClass('is-open')) {
                    pendingOrderUrl = null;
                    closeOrderConfirm();
                }
            });

            $(document).on('click', '[data-confirm-agree]', function () {
                if (!pendingRemove || $(this).hasClass('is-loading')) {
                    return;
                }

                var agreeButton = $(this);
                var cthdId = pendingRemove.id;
                var itemRow = pendingRemove.item;

                agreeButton.addClass('is-loading');
                itemRow.addClass('is-removing');

                $.ajax({
                    url: '@Url.Action("RemoveItem", "Home")',
                    type: 'POST',
                    data: {
                        id: cthdId
                    },
                    success: function(response) {
                        closeRemoveConfirm();
                        refreshCartContent(response);
                    },
                    error: function(xhr, status, error) {
                        itemRow.removeClass('is-removing');
                        console.log("Remove item error: " + error);
                    },
                    complete: function() {
                        agreeButton.removeClass('is-loading');
                        pendingRemove = null;
                    }
                });
            });

            $(document).on('click', '.cart-order-submit', function (event) {
                event.preventDefault();
                const orderUrl = $(this).attr('href');
                if (orderUrl) {
                    openOrderConfirm(orderUrl);
                }
            });

            $(document).on('click', '[data-order-cancel]', function () {
                pendingOrderUrl = null;
                closeOrderConfirm();
            });

            $(document).on('click', '[data-order-agree]', function () {
                if (!pendingOrderUrl || $(this).hasClass('is-loading')) {
                    return;
                }

                const agreeButton = $(this);
                agreeButton.addClass('is-loading');

                $.ajax({
                    url: pendingOrderUrl,
                    type: 'GET',
                    success: function(response, status, xhr) {
                        const redirectedUrl = xhr.responseURL || successRedirectUrl;
                        if (redirectedUrl.indexOf('/Home/Cart') !== -1) {
                            window.location.href = redirectedUrl;
                            return;
                        }
                        successRedirectUrl = redirectedUrl;
                        closeOrderConfirm();
                        openOrderSuccess();
                    },
                    error: function(xhr, status, error) {
                        console.log("Order submit error: " + error);
                        window.location.href = pendingOrderUrl;
                    },
                    complete: function() {
                        agreeButton.removeClass('is-loading');
                        pendingOrderUrl = null;
                    }
                });
            });

            $(document).on('click', '[data-success-ok]', function () {
                window.location.href = successRedirectUrl;
            });

            function requestClearCartConfirm() {
                if ($('.btn--clear-cart').hasClass('is-loading') || !$('.btn--clear-cart').is(':visible')) {
                    return;
                }

                openClearConfirm();
            }

            function clearCart() {
                const clearButton = $('.btn--clear-cart');
                const agreeButton = $('[data-clear-agree]');

                if (clearButton.hasClass('is-loading')) {
                    return;
                }

                clearButton.addClass('is-loading');
                agreeButton.addClass('is-loading');

                $.ajax({
                    url: '@Url.Action("ClearCart", "Home")',
                    type: 'POST',
                    success: function(response) {
                        closeClearConfirm();
                        refreshCartContent(response);
                    },
                    error: function(xhr, status, error) {
                        console.log("Clear cart error: " + error);
                    },
                    complete: function() {
                        clearButton.removeClass('is-loading');
                        agreeButton.removeClass('is-loading');
                    }
                });
            }

            $(document).on('click', '.btn--clear-cart', requestClearCartConfirm);
            $(document).on('keydown', '.btn--clear-cart', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    requestClearCartConfirm();
                }
            });
            $(document).on('click', '[data-clear-cancel]', closeClearConfirm);
            $(document).on('click', '[data-clear-agree]', clearCart);

            syncCartHeaderActions();
        });

        // ==== ==== sử lý sự thay đổi của database
        const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

        // Khởi tạo kết nối SignalR
        connection.start().catch(err => console.error(err.toString()));

        connection.on("DatabaseUpdated", function () {
            console.log("Database đã được thay đổi");
           // Gọi AJAX để lấy partial view từ server
            $.get('/Home/GetCTHD', function (data) {
                const content = document.getElementById("cart__content_");
                content.innerHTML = data; //Thay thế nội dung của danh sách bằng HTML từ partial view
                $('.btn--clear-cart').toggle($("div#cart__content_ .bought--item").length > 0);
            });
        });

    </script>

</body>

</html>
