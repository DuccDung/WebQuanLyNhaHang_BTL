@model WebQuanLyNhaHang.ViewModel.ViewModelCart
@{
    int? DhId = Context.Session.GetInt32("DhId");
    int? BanId = Context.Session.GetInt32("BanId");
    var cartItems = Model.CTHD_PctByDh(DhId);
    var cartTotal = Model.TongtienById(DhId).TongTien ?? 0;
    var hasCartItems = cartItems.Any();
}

    <div class="container__card">
    @if (!hasCartItems)
    {
        <div class="cart-empty">
            <h2>Giỏ hàng đang trống</h2>
            <p>Bạn chưa chọn món nào. Hãy quay lại menu để thêm đồ uống hoặc bánh yêu thích.</p>
            <a asp-controller="Home" asp-action="Menu">Xem menu</a>
        </div>
    }
    else
    {
        @foreach (var item in cartItems)
        {
            <div class="bought--item">
                <div class="item-editor">
                    <div class="item-box">
                        <div class="item-inner--right">
                            <div class="card-img" style="background-image: url(@item.PathPhoto);">
                            </div>
                            <div class="card-product-info">
                                <span>
                                    <span style="color: var(--primary--color)">@item.SoLuong x</span> @item.TenSanPham
                                </span>
                                <span class="card-product--description">
                                    @item.Condition
                                </span>
                                <span class="card-product--price">
                                    @String.Format("{0:N0}", item.ThanhTien)đ
                                </span>
                            </div>
                        </div>
                        <div class="item-inner--left">
                            <div class="btn-remove" id="cart__btn-remove" data-id="@item.CthdId" data-name="@item.TenSanPham">
                                <i class="fa-solid fa-xmark"></i>
                            </div>
                            <a asp-controller="Home" asp-action="ProductDetail" asp-route-ProductID="@item.ProductId" asp-route-cthdId="@item.CthdId" class="btn-edit">
                                <span>edit</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    </div>

     @if(hasCartItems){
          <div class="card__total-price">
                    <div>Tổng Tiền</div>
                    <div>@String.Format("{0:N0}", cartTotal)đ</div>
          </div>
          <div class="btn-sumbit">
                <a asp-controller="Home" asp-action="OrderSuccess" class="cart-order-submit">
                    <button class="buy__item outline" style="background-color: rgb(247, 148, 30); height: 44px;">
                        Gửi yêu cầu gọi món
                    </button>
                </a>
            </div>
     }
           
     
