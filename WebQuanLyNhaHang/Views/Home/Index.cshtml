@{
    Layout = "_CloudyCafeLayout";
    ViewData["Title"] = "Cloudy Café - Đăng nhập";
}

<div class="container page-pad">
    <div class="auth-wrap">
        <a class="back-link" asp-controller="TrangChu" asp-action="Index">
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 19-7-7 7-7"></path>
                <path d="M19 12H5"></path>
            </svg>
            Quay về trang chủ
        </a>

        <div class="auth-card">
            <h1>Đăng nhập</h1>
            <p>Chào mừng bạn quay lại với Cloudy Café</p>

            @if (TempData["error"] != null)
            {
                <div class="notice auth-message auth-message--error">@TempData["error"]</div>
            }

            @if (TempData["success"] != null)
            {
                <div class="notice auth-message auth-message--success">@TempData["success"]</div>
            }

            <div class="notice auth-note">
                Đăng nhập để thêm sản phẩm vào giỏ hàng online và theo dõi đơn giao hàng của bạn.
            </div>

            <form class="form-grid" asp-controller="Home" asp-action="CustomerLogin" method="post">
                <label>
                    <span class="form-label">Email</span>
                    <input class="input" name="email" type="email" placeholder="Nhập email của bạn" autocomplete="email" required>
                </label>

                <label>
                    <span class="form-label">Mật khẩu</span>
                    <input class="input" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" required>
                </label>

                <button class="btn full" type="submit">Đăng nhập</button>
            </form>

            <details class="auth-extra">
                <summary>
                    Chưa có tài khoản?
                    <span class="accent-link">Đăng ký ngay</span>
                </summary>

                <form class="form-grid auth-extra-form" asp-controller="Home" asp-action="CustomerRegister" method="post">
                    <label>
                        <span class="form-label">Họ tên</span>
                        <input class="input" name="username" type="text" placeholder="Nhập tên của bạn" autocomplete="name" required>
                    </label>

                    <label>
                        <span class="form-label">Email</span>
                        <input class="input" name="email" type="email" placeholder="Nhập email đăng ký" autocomplete="email" required>
                    </label>

                    <label>
                        <span class="form-label">Mật khẩu</span>
                        <input class="input" name="password" type="password" placeholder="Tạo mật khẩu" autocomplete="new-password" required>
                    </label>

                    <button class="btn full outline" type="submit">Tạo tài khoản</button>
                </form>
            </details>
        </div>
    </div>
</div>
