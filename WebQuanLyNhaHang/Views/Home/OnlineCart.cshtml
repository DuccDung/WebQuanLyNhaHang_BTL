@model WebQuanLyNhaHang.ViewModel.ViewModelCart
@{
    Layout = "_CloudyCafeLayout";
    ViewData["Title"] = "Giỏ hàng online";
}

<div class="online-cart-page">
    <div id="online-cart-content">
        @await Html.PartialAsync("OnlineCTDHTable", Model)
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>
    <script>
        const onlineCartContent = document.getElementById("online-cart-content");

        function updateHeaderCartCount() {
            const cartGrid = onlineCartContent?.querySelector(".online-cart-grid");
            const cartCount = cartGrid?.dataset.cartCount ?? "0";
            document.querySelectorAll(".cart-count").forEach(function (badge) {
                badge.textContent = cartCount;
            });
        }

        async function refreshOnlineCartFromResponse(response) {
            if (!response.ok) {
                return;
            }

            onlineCartContent.innerHTML = await response.text();
            updateHeaderCartCount();
        }

        onlineCartContent?.addEventListener("click", async function (event) {
            const removeButton = event.target.closest(".js-online-remove");
            if (removeButton) {
                const formData = new FormData();
                formData.append("id", removeButton.dataset.id);

                const response = await fetch("@Url.Action("RemoveOnlineItem", "Home")", {
                    method: "POST",
                    body: formData
                });

                await refreshOnlineCartFromResponse(response);
                return;
            }

            const quantityButton = event.target.closest(".js-online-qty");
            if (quantityButton) {
                const quantityWrap = quantityButton.closest(".online-cart-qty");
                const currentQuantity = Number(quantityWrap?.dataset.quantity ?? "1");
                const action = quantityButton.dataset.action;
                const nextQuantity = action === "increase"
                    ? currentQuantity + 1
                    : Math.max(1, currentQuantity - 1);

                const formData = new FormData();
                formData.append("id", quantityButton.dataset.id);
                formData.append("quantity", nextQuantity.toString());

                const response = await fetch("@Url.Action("UpdateOnlineItemQuantity", "Home")", {
                    method: "POST",
                    body: formData
                });

                await refreshOnlineCartFromResponse(response);
            }
        });

        const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
        connection.start().catch(err => console.error(err.toString()));

        connection.on("OnlineCartUpdated", function () {
            fetch("@Url.Action("GetOnlineCTHD", "Home")")
                .then(response => response.text())
                .then(html => {
                    if (onlineCartContent) {
                        onlineCartContent.innerHTML = html;
                        updateHeaderCartCount();
                    }
                });
        });
    </script>
}
