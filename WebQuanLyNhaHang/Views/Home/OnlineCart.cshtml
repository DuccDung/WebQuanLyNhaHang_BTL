@model WebQuanLyNhaHang.ViewModel.ViewModelCart

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebQuanLyTuXa.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/asset/css/base.css">
    <link rel="stylesheet" href="~/asset/css/home.css">
    <link rel="stylesheet" href="~/asset/css/responsive.css">
    <link rel="stylesheet" href="~/asset/css/card.css" asp-append-version="true">
    <link rel="stylesheet" href="~/asset/font/fontawesome-free-6.5.2-web/fontawesome-free-6.5.2-web/css/all.min.css">
    <title>Giỏ hàng online</title>
</head>
<body>
    <div class="online-cart-page">
        <div class="online-cart-header">
            <a class="online-cart-back" asp-controller="TrangChu" asp-action="Menu" aria-label="Quay lại menu">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <div>
                <h1>Giỏ hàng online</h1>
                <p>Kiểm tra món đã chọn và nhập thông tin giao hàng.</p>
            </div>
        </div>

        <div id="online-cart-content">
            @await Html.PartialAsync("OnlineCTDHTable", Model)
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $(document).on('click', '.js-online-remove', function () {
                var cthdId = $(this).data('id');

                $.ajax({
                    url: '@Url.Action("RemoveOnlineItem", "Home")',
                    type: 'POST',
                    data: {
                        id: cthdId
                    },
                    success: function(response) {
                        $("div#online-cart-content").html(response);
                    },
                    error: function(xhr, status, error) {
                        console.log("Đã có lỗi xảy ra: " + error);
                    }
                });
            });
        });

        const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
        connection.start().catch(err => console.error(err.toString()));

        connection.on("OnlineCartUpdated", function () {
            $.get('/Home/GetOnlineCTHD', function (data) {
                const content = document.getElementById("online-cart-content");
                content.innerHTML = data;
            });
        });
    </script>
</body>
</html>
