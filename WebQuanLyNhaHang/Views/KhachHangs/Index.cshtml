@model WebQuanLyNhaHang.ViewModel.CustomersIndexViewModel
@using System.Globalization
@{
    Layout = "_AdminContentLayout";
    ViewData["Title"] = "Khách hàng";
    ViewData["ActiveAdminNav"] = "Customers";
    ViewData["AdminTopbarClass"] = "topbar--customers";
    ViewData["ShowAdminTopbarMeta"] = false;
    var culture = CultureInfo.GetCultureInfo("vi-VN");

    string FormatCurrency(decimal value) => $"{value.ToString("N0", culture)}đ";
    string FormatLastPurchase(DateTime? value) => value.HasValue
        ? $"Mua gần: {value.Value.ToString("dd/MM/yyyy", culture)}"
        : "Chưa có đơn hàng";
}

@section Styles
{
    <link rel="stylesheet" href="~/assets/css/admin-customers.css" asp-append-version="true" />
}


<div class="customers-page">
    <section class="customer-stats-grid" aria-label="Thống kê khách hàng">
        <article class="customer-stat-card">
            <p>Tổng Khách Hàng</p>
            <strong data-customer-stat="total">@Model.TotalCustomers.ToString("N0", culture)</strong>
        </article>
        <article class="customer-stat-card">
            <p>VIP</p>
            <strong class="is-vip" data-customer-stat="vip">@Model.VipCustomers.ToString("N0", culture)</strong>
        </article>
        <article class="customer-stat-card">
            <p>Khách Thường</p>
            <strong class="is-regular" data-customer-stat="regular">@Model.RegularCustomers.ToString("N0", culture)</strong>
        </article>
        <article class="customer-stat-card">
            <p>Khách Mới</p>
            <strong data-customer-stat="new">@Model.NewCustomers.ToString("N0", culture)</strong>
        </article>
    </section>

    <section class="customer-filter-card" aria-label="Tìm kiếm khách hàng">
        <label class="customer-search">
            <svg viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
                <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <input type="search" data-customer-search placeholder="Tìm kiếm theo tên, số điện thoại..." />
        </label>

        <div class="customers-actions">
            <button class="customer-add-button" type="button" data-open-customer-create>
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
                Thêm Khách Hàng
            </button>
        </div>
    </section>

    <section class="customer-table-card">
        <div class="customer-table-wrap">
            <table class="customer-table" data-customers-table>
                <thead>
                    <tr>
                        <th>Khách Hàng</th>
                        <th>Liên Hệ</th>
                        <th>Địa Chỉ</th>
                        <th class="is-center">Đơn Hàng</th>
                        <th class="is-right">Tổng Chi Tiêu</th>
                        <th>Hạng</th>
                        <th class="is-right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Customers)
                    {
                        <tr data-customer-row data-search="@item.SearchText">
                            <td data-label="Khách Hàng">
                                <div class="customer-profile">
                                    <span class="customer-avatar">@item.Initial</span>
                                    <span class="customer-profile__copy">
                                        <strong>@item.CustomerName</strong>
                                        <small>@FormatLastPurchase(item.LastPurchase)</small>
                                    </span>
                                </div>
                            </td>
                            <td data-label="Liên Hệ">
                                <div class="customer-contact">
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6.4 6.4l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                        @item.Phone
                                    </span>
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"></rect>
                                            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                        @item.Email
                                    </span>
                                </div>
                            </td>
                            <td data-label="Địa Chỉ">
                                <span class="customer-address">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                                        <circle cx="12" cy="10" r="2.3" stroke="currentColor" stroke-width="1.8"></circle>
                                    </svg>
                                    @item.Address
                                </span>
                            </td>
                            <td class="is-center" data-label="Đơn Hàng">
                                <strong class="customer-order-count">@item.OrderCount.ToString("N0", culture)</strong>
                            </td>
                            <td class="is-right" data-label="Tổng Chi Tiêu">
                                <strong class="customer-total">@FormatCurrency(item.TotalSpent)</strong>
                            </td>
                            <td data-label="Hạng">
                                <span class="tier-pill @item.TierCssClass">@item.TierLabel</span>
                            </td>
                            <td class="is-right" data-label="Chi Tiết">
                                <button class="customer-detail-button" type="button" data-customer-detail-url="@Url.Action("DetailsData", "KhachHangs", new { id = item.CustomerId })">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="2"></path>
                                        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"></circle>
                                    </svg>
                                    Chi Tiết
                                </button>
                            </td>
                        </tr>
                    }
                    <tr class="customer-empty-row" data-empty-row hidden>
                        <td colspan="7">Không tìm thấy khách hàng phù hợp với từ khóa hiện tại.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="customer-modal" id="customer-create-modal" aria-hidden="true">
    <div class="customer-modal__backdrop" data-close-customer-create></div>
    <div class="customer-modal__card" role="dialog" aria-modal="true" aria-labelledby="customer-create-title">
        <div class="customer-modal__header">
            <div>
                <p>Thông tin khách hàng</p>
                <h2 id="customer-create-title">Thêm Khách Hàng</h2>
            </div>
            <button class="customer-modal__close" type="button" aria-label="Đóng popup" data-close-customer-create>
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                </svg>
            </button>
        </div>

        <form class="customer-create-form" asp-action="CreateFromModal" method="post" data-customer-create-form>
            @Html.AntiForgeryToken()

            <div class="customer-form-alert" data-customer-create-alert hidden></div>

            <div class="customer-form-grid">
                <label class="customer-field">
                    <span>Tên khách hàng</span>
                    <input class="customer-input" type="text" name="TenKhachHang" placeholder="Nhập tên khách hàng" required />
                </label>

                <label class="customer-field">
                    <span>Số điện thoại</span>
                    <input class="customer-input" type="tel" name="SoDienThoai" placeholder="Nhập số điện thoại" />
                </label>

                <label class="customer-field customer-field--full">
                    <span>Địa chỉ</span>
                    <input class="customer-input" type="text" name="DiaChi" placeholder="Nhập địa chỉ khách hàng" />
                </label>

                <label class="customer-field">
                    <span>Tài khoản</span>
                    <input class="customer-input" type="text" name="TaiKhoan" placeholder="Nhập tài khoản hoặc email" required />
                </label>

                <label class="customer-field">
                    <span>Mật khẩu</span>
                    <input class="customer-input" type="password" name="MatKhau" placeholder="Nhập mật khẩu" required />
                </label>

                <label class="customer-field customer-field--full">
                    <span>Ảnh đại diện</span>
                    <input class="customer-input" type="text" name="PathPhoto" placeholder="Đường dẫn ảnh nếu có" />
                </label>
            </div>

            <div class="customer-modal__actions">
                <button class="customer-secondary-button" type="button" data-close-customer-create>Hủy</button>
                <button class="customer-primary-button" type="submit" data-customer-create-submit>
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    </svg>
                    Lưu khách hàng
                </button>
            </div>
        </form>
    </div>
</div>

<div class="customer-detail-modal" id="customer-detail-modal" hidden aria-hidden="true">
    <button class="customer-detail-modal__backdrop" type="button" data-close-customer-detail aria-label="Đóng chi tiết khách hàng"></button>

    <section class="customer-detail-dialog" role="dialog" aria-modal="true" aria-labelledby="customer-detail-title">
        <button class="customer-detail-close" type="button" data-close-customer-detail aria-label="Đóng">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
        </button>

        <div class="customer-detail-loading" data-customer-detail-loading>
            <span class="customer-detail-spinner" aria-hidden="true"></span>
            <p>Đang tải chi tiết khách hàng...</p>
        </div>

        <div class="customer-detail-error" data-customer-detail-error hidden>
            <strong>Không tải được thông tin khách hàng</strong>
            <p>Vui lòng thử lại sau ít phút.</p>
        </div>

        <div class="customer-detail-content" data-customer-detail-content hidden>
            <div class="customer-detail-hero">
                <span class="customer-detail-avatar" data-customer-detail-initial>K</span>
                <div>
                    <div class="customer-detail-kicker" data-customer-detail-code>KH000</div>
                    <h2 id="customer-detail-title" data-customer-detail-name>Khách hàng</h2>
                    <span class="tier-pill is-new" data-customer-detail-tier>Mới</span>
                </div>
            </div>

            <div class="customer-detail-summary">
                <article>
                    <span>Tổng đơn hàng</span>
                    <strong data-customer-detail-order-count>0</strong>
                </article>
                <article>
                    <span>Tổng chi tiêu</span>
                    <strong class="is-orange" data-customer-detail-total>0đ</strong>
                </article>
                <article>
                    <span>Mua gần nhất</span>
                    <strong data-customer-detail-last>Chưa có đơn hàng</strong>
                </article>
            </div>

            <div class="customer-detail-grid">
                <article class="customer-detail-panel">
                    <h3>Thông tin liên hệ</h3>
                    <dl class="customer-detail-list">
                        <div>
                            <dt>Số điện thoại</dt>
                            <dd data-customer-detail-phone>Chưa có SĐT</dd>
                        </div>
                        <div>
                            <dt>Email</dt>
                            <dd data-customer-detail-email>Chưa có email</dd>
                        </div>
                        <div>
                            <dt>Địa chỉ</dt>
                            <dd data-customer-detail-address>Chưa cập nhật địa chỉ</dd>
                        </div>
                    </dl>
                </article>

                <article class="customer-detail-panel">
                    <h3>Tài khoản</h3>
                    <dl class="customer-detail-list">
                        <div>
                            <dt>Tài khoản</dt>
                            <dd data-customer-detail-account>Chưa có tài khoản</dd>
                        </div>
                        <div>
                            <dt>Mật khẩu</dt>
                            <dd data-customer-detail-password>••••••••</dd>
                        </div>
                        <div>
                            <dt>Ảnh đại diện</dt>
                            <dd data-customer-detail-photo>Chưa có ảnh đại diện</dd>
                        </div>
                    </dl>
                </article>
            </div>

            <article class="customer-detail-panel customer-detail-panel--orders">
                <div class="customer-detail-panel__title">
                    <h3>Đơn hàng gần đây</h3>
                    <span data-customer-detail-recent-count>0 đơn</span>
                </div>
                <div class="customer-detail-orders" data-customer-detail-orders></div>
            </article>
        </div>
    </section>
</div>

@section Scripts
{
    <script src="~/assets/js/admin-customers.js" asp-append-version="true"></script>
}

