  <!-- jQuery CDN (thư viện jQuery được tải từ Content Delivery Network) -->
<style>
    /* Phần chọn số lượng */
    .ComponentProduct__quantity-selector {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        min-height: 32px;
    }

        .ComponentProduct__quantity-selector .quantity-btn {
            background-color: #f57c00cc;
            color: #fff;
            border: none;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            min-width: 22px;
            font-size: 16px;
            line-height: 1;
            cursor: pointer;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            padding: 0;
            margin: 0;
            position: relative;
            overflow: hidden;
            font-size: 0;
        }

        .ComponentProduct__quantity-selector .quantity-btn::before {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -52%);
            font-family: Arial, sans-serif;
            font-size: 16px;
            font-weight: 400;
            line-height: 1;
        }

        .ComponentProduct__quantity-selector .decrease-btn::before {
            content: "-";
        }

        .ComponentProduct__quantity-selector .increase-btn::before {
            content: "+";
        }

        .ComponentProduct__quantity-selector .quantity-input {
            width: 28px;
            height: 22px;
            text-align: center;
            border: none;
            font-size: 15px;
            line-height: 22px;
            padding: 0;
            margin: 0 4px;
            background: transparent;
        }

        /* Điều chỉnh màu nút */
        .ComponentProduct__quantity-selector .quantity-btn:hover {
            background-color: #d46a00;
        }

        .ComponentProduct__quantity-selector.is-loading .quantity-btn,
        .ComponentProduct__quantity-selector.is-loading .quantity-input {
            pointer-events: none;
            opacity: .58;
        }

        .ComponentProduct__quantity-selector .quantity-btn.is-loading::before {
            content: "";
            width: 11px;
            height: 11px;
            border: 2px solid rgba(255, 255, 255, .48);
            border-top-color: #fff;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: cloudy-menu-spin .65s linear infinite;
        }

        @@keyframes cloudy-menu-spin {
            to {
                transform: translate(-50%, -50%) rotate(360deg);
            }
        }

        .ComponentProduct__quantity-selector form {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin: 0;
            height: 32px;
        }
    /* Ẩn nút tăng/giảm trên Chrome, Safari, Edge, Opera */
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>
@model WebQuanLyNhaHang.ViewModel.QuantitySelector // đón dữ liệu số lượng
<div class="ComponentProduct__quantity-selector" data-product-id="@Model.ProductId" data-dh-id="@Model.DhId">
    <form asp-controller="ChiTietHoaDons" asp-action="Decrease" method="post" id="quantityForm">
        <button type="button" class="quantity-btn decrease-btn" data-product-id="@Model.ProductId">−</button>
        <input type="number" name="Soluong" value="@Model.Soluong" class="quantity-input soluongInput">
        <input type="hidden" name="ProductId" value="@Model.ProductId" />
        <input type="hidden" name="DhId" value="@Model.DhId" />
        <button type="button" class="quantity-btn increase-btn" data-product-id="@Model.ProductId">+</button>
    </form>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.9/signalr.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
        (function () {
            if (window.cloudyMenuQuantityReady) {
                return;
            }

            window.cloudyMenuQuantityReady = true;

            if (window.signalR && !window.cloudyMenuSignalRConnection) {
                window.cloudyMenuSignalRConnection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
                window.cloudyMenuSignalRConnection.start().catch(function (err) {
                    console.error(err.toString());
                });
            }

            function setLoading($selector, $button, isLoading) {
                $selector.toggleClass("is-loading", isLoading);
                $button.toggleClass("is-loading", isLoading);
                $selector.find("button, input").prop("disabled", isLoading);
            }

            function updateFooterCount(delta) {
                var $footerContent = $(".foodter__content");

                if (!$footerContent.length) {
                    return;
                }

                var currentText = $footerContent.text();
                var currentCount = parseInt((currentText.match(/\d+/) || ["0"])[0], 10);
                var nextCount = Math.max(0, currentCount + delta);

                if (nextCount === 0) {
                    $(".foodter").closest(".app__menu").fadeOut(180, function () {
                        $(this).remove();
                    });
                    return;
                }

                $footerContent.text("Xem giỏ hàng(" + nextCount + " món)");
            }

            function renderAddButton($selector, productId) {
                var addHtml = '<a href="/Home/ProductDetail?ProductID=' + productId + '"><button type="button">+</button></a>';
                $selector.fadeOut(120, function () {
                    $(this).replaceWith(addHtml);
                });
            }

            $(document).on("click", ".ComponentProduct__quantity-selector .decrease-btn", function (event) {
                event.preventDefault();

                var $button = $(this);
                var $selector = $button.closest(".ComponentProduct__quantity-selector");
                var $form = $button.closest("form");
                var $soluongInput = $form.find(".soluongInput");
                var soluong = parseInt($soluongInput.val(), 10);
                var productId = $button.data("product-id");
                var dhId = $form.find('input[name="DhId"]').val();

                if ($selector.hasClass("is-loading")) {
                    return;
                }

                setLoading($selector, $button, true);

                if (soluong > 1) {
                    $.ajax({
                        url: "/ChiTietHoaDons/Decrease",
                        type: "POST",
                        data: {
                            Soluong: soluong,
                            ProductId: productId,
                            DhId: dhId
                        },
                        success: function (response) {
                            if (response.error) {
                                console.error(response.error);
                                return;
                            }

                            $soluongInput.val(response.newQuantity);
                        },
                        error: function (xhr, status, error) {
                            console.error("Có lỗi xảy ra:", error);
                        },
                        complete: function () {
                            setLoading($selector, $button, false);
                        }
                    });
                    return;
                }

                $.ajax({
                    url: "/ChiTietHoaDons/DeleteProductDetail",
                    type: "POST",
                    data: {
                        ProductId: productId,
                        DhId: dhId
                    },
                    success: function (response) {
                        if (response.error) {
                            console.error(response.error);
                            setLoading($selector, $button, false);
                            return;
                        }

                        updateFooterCount(-1);
                        renderAddButton($selector, productId);
                    },
                    error: function (xhr, status, error) {
                        console.error("Có lỗi xảy ra khi gửi yêu cầu:", error);
                        setLoading($selector, $button, false);
                    }
                });
            });

            $(document).on("click", ".ComponentProduct__quantity-selector .increase-btn", function (event) {
                event.preventDefault();

                var $button = $(this);
                var $selector = $button.closest(".ComponentProduct__quantity-selector");
                var $form = $button.closest("form");
                var $soluongInput = $form.find(".soluongInput");
                var soluong = parseInt($soluongInput.val(), 10);
                var productId = $button.data("product-id");
                var dhId = $form.find('input[name="DhId"]').val();

                if ($selector.hasClass("is-loading")) {
                    return;
                }

                setLoading($selector, $button, true);

                $.ajax({
                    url: "/ChiTietHoaDons/Increase",
                    type: "POST",
                    data: {
                        Soluong: soluong,
                        ProductId: productId,
                        DhId: dhId
                    },
                    success: function (response) {
                        if (response.error) {
                            console.error(response.error);
                            return;
                        }

                        $soluongInput.val(response.newQuantity);
                    },
                    error: function (xhr, status, error) {
                        console.error("Có lỗi xảy ra:", error);
                    },
                    complete: function () {
                        setLoading($selector, $button, false);
                    }
                });
            });
        })();
</script>
</div>

