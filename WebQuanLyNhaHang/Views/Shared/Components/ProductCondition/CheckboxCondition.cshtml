@model List<WebQuanLyNhaHang.Models.ProductConditions>
@{
    var selectedCondition = ViewData["SelectedCondition"] as string;
}

<div class="component__product-selector flag__scroll">
    <div>
        <div class="item-selector-header">
            Loại
        </div>
        @foreach (var item in Model)
        {
            var optionId = $"condition-{item.ProductConditionId}";
            var isChecked = !string.IsNullOrWhiteSpace(selectedCondition)
                ? string.Equals(item.Condition, selectedCondition, StringComparison.OrdinalIgnoreCase)
                : item == Model.First();

            <div class="select-item product-condition-option">
                <div class="component__cs-radio">
                    <input class="component__cs-radio--border" type="radio" id="@optionId" name="condition" value="@item.Condition" checked="@isChecked">
                    <label class="radio-label" for="@optionId">@item.Condition</label>
                </div>
            </div>
        }
    </div>
</div>
