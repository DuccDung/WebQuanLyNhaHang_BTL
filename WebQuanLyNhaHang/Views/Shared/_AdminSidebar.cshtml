@using Microsoft.AspNetCore.Http
@{
    var activeNav = ViewData["ActiveAdminNav"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    if (string.IsNullOrWhiteSpace(activeNav))
    {
        activeNav = controller switch
        {
            "Admin" when action == "Ban" => "DineIn",
            "Admin" => "Dashboard",
            "Products" => "Products",
            "DonHangs" => "TakeAway",
            "ChiTietHoaDons" => "OrderDetails",
            "KhachHangs" => "Customers",
            "NhanViens" => "Employees",
            "AdminCuaHangs" => "Stores",
            "AdminBaiVietChuyenNhas" => "Stories",
            _ => string.Empty
        };
    }

    var adminName = Context.Session.GetString("NhanVienName") ?? "Admin";
    var canViewDashboard = Context.CanAccessModule(PermissionModules.Reports);
    var canViewProducts = Context.CanAccessModule(PermissionModules.Products);
    var canViewOrders = Context.CanAccessModule(PermissionModules.OnlineOrders);
    var canViewOrderDetails = Context.CanAccessModule(PermissionModules.OrderDetails);
    var canViewCustomers = Context.CanAccessModule(PermissionModules.Customers);
    var canViewEmployees = Context.CanAccessModule(PermissionModules.Employees);
    var canViewStores = Context.CanAccessModule(PermissionModules.Stores);
    var canViewStories = Context.CanAccessModule(PermissionModules.Stories);
    var canViewDineIn = Context.CanAccessModule(PermissionModules.DineIn);
    var adminRoleLabel = "Quản trị vận hành";
    var initials = string.Concat(
        adminName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "A";
    }

    var isSalesActive = activeNav is "Dashboard" or "DineIn" or "TakeAway";
}

<aside class="sidebar" id="dashboard-sidebar">
    <div class="sidebar__brand">
        <div class="brand-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M7 3v8M10 3v8M5 3h7M16 3v18M19 3v18M16 12h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </div>
        <span>F&amp;B Admin</span>
    </div>

    <nav class="sidebar__nav">
        <a class="nav-item @(activeNav == "Dashboard" ? "is-active" : null)" href="@Url.Action("Index", "Admin")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="2"></rect><rect x="14" y="4" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="2"></rect><rect x="4" y="14" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="2"></rect><rect x="14" y="14" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="2"></rect></svg>
            </span>
            <span>Dashboard</span>
        </a>

        <a class="nav-item @(activeNav == "Products" ? "is-active" : null)" href="@Url.Action("Index", "Products")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><path d="m12 12 8-4.5M12 12 4 7.5M12 12v9" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            </span>
            <span>Sản phẩm</span>
        </a>

        <a class="nav-item @(activeNav == "TakeAway" || activeNav == "Orders" ? "is-active" : null)" href="@Url.Action("Index", "DonHangs")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="20" r="1.7" fill="currentColor"></circle><circle cx="18" cy="20" r="1.7" fill="currentColor"></circle><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.5L22 7H8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Đơn hàng</span>
        </a>

        <a class="nav-item @(activeNav == "OrderDetails" ? "is-active" : null)" href="@Url.Action("Index", "ChiTietHoaDons")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M7 4h10M7 8h10M7 12h6M5 4h.01M5 8h.01M5 12h.01M7 16h10M5 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            </span>
            <span>Chi tiết đơn</span>
        </a>

        <a class="nav-item @(activeNav == "Customers" ? "is-active" : null)" href="@Url.Action("Index", "KhachHangs")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M16 21a4 4 0 0 0-8 0M20 21a4 4 0 0 0-2.4-3.65M6.4 17.35A4 4 0 0 0 4 21M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM18 11a3 3 0 1 0 0-6M6 11A3 3 0 1 0 6 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Khách hàng</span>
        </a>

        <a class="nav-item @(activeNav == "Employees" ? "is-active" : null)" href="@Url.Action("Index", "NhanViens")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M16 21a4 4 0 0 0-8 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18.5 9.5 20 11l2.5-2.5M20 7.5v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Nhân viên</span>
        </a>

        <a class="nav-item @(activeNav == "Stores" ? "is-active" : null)" href="@Url.Action("Index", "AdminCuaHangs")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 10 6 4h12l2 6M5 10v10h14V10M9 14h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Cửa hàng</span>
        </a>

        <a class="nav-item @(activeNav == "Stories" ? "is-active" : null)" href="@Url.Action("Index", "AdminBaiVietChuyenNhas")">
            <span class="nav-item__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Chuyện nhà</span>
        </a>

        <div class="nav-group is-open" id="sales-group">
            <button class="nav-item nav-item--button @(isSalesActive ? "is-active" : null)" id="sales-group-toggle" type="button" aria-expanded="true">
                <span class="nav-item__main">
                    <span class="nav-item__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M7 3v8M10 3v8M5 3h7M16 3v18M19 3v18M16 12h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </span>
                    <span>Trang bán hàng</span>
                </span>
                <span class="nav-group__chevron" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                </span>
            </button>

            <div class="nav-submenu" id="sales-submenu">
                <a class="nav-subitem @(activeNav == "DineIn" ? "is-active" : null)" href="@Url.Action("Ban", "Admin")">
                    <span class="nav-item__icon nav-item__icon--small" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 8.5 6.5 5h11L20 8.5V19H4V8.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path><path d="M4 9h16M9 13h6M8 16h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                    </span>
                    <span>Đơn tại quán</span>
                </a>
                <a class="nav-subitem @(activeNav == "TakeAway" ? "is-active" : null)" href="@Url.Action("Index", "DonHangs")">
                    <span class="nav-item__icon nav-item__icon--small" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"></circle><path d="M3.6 12h16.8M12 3c2.2 2.3 3.3 5.3 3.3 9S14.2 18.7 12 21M12 3C9.8 5.3 8.7 8.3 8.7 12S9.8 18.7 12 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                    </span>
                    <span>Đơn mang về</span>
                </a>
            </div>
        </div>
    </nav>

    <div class="sidebar__user">
        <div class="sidebar-user">
            <div class="sidebar-user__avatar">@initials</div>
            <div class="sidebar-user__meta">
                <p>@adminName</p>
                <span>@adminRoleLabel</span>
            </div>
        </div>

        <a class="logout-button" href="@Url.Action("Logout", "Admin")">
            <span class="logout-button__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M15 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            <span>Đăng xuất</span>
        </a>
    </div>
</aside>
