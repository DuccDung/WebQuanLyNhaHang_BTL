@model WebQuanLyNhaHang.ViewModel.EmployeesIndexViewModel
@using System.Globalization
@{
    Layout = "_AdminContentLayout";
    ViewData["Title"] = "Nhân viên";
    ViewData["ActiveAdminNav"] = "Employees";
    ViewData["AdminTopbarClass"] = "topbar--employees";
    ViewData["ShowAdminTopbarMeta"] = false;
    var culture = CultureInfo.GetCultureInfo("vi-VN");

    string FormatCurrency(decimal value) => $"{value.ToString("N0", culture)}đ";
    string FormatDate(DateOnly? value) => value.HasValue
        ? value.Value.ToString("dd/MM/yyyy", culture)
        : "Chưa cập nhật";
}

@section Styles
{
    <link rel="stylesheet" href="~/assets/css/admin-employees.css" asp-append-version="true" />
}


<div class="employees-page">
    <section class="employee-stats-grid" aria-label="Thống kê nhân viên">
        <article class="employee-stat-card">
            <p>Tổng Nhân Viên</p>
            <strong>@Model.TotalEmployees.ToString("N0", culture)</strong>
        </article>
        <article class="employee-stat-card">
            <p>Quản Lý</p>
            <strong class="is-manager">@Model.ManagerEmployees.ToString("N0", culture)</strong>
        </article>
        <article class="employee-stat-card">
            <p>Nhân Viên Bếp</p>
            <strong class="is-kitchen">@Model.KitchenEmployees.ToString("N0", culture)</strong>
        </article>
        <article class="employee-stat-card">
            <p>Phục Vụ</p>
            <strong class="is-service">@Model.ServiceEmployees.ToString("N0", culture)</strong>
        </article>
    </section>

    <section class="employee-filter-card" aria-label="Bộ lọc nhân viên">
        <label class="employee-search">
            <svg viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
                <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <input type="search" data-employee-search placeholder="Tìm kiếm nhân viên..." />
        </label>

        <label class="employee-select">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M16 21a4 4 0 0 0-8 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M16 11h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <select data-employee-role-filter aria-label="Lọc theo chức vụ">
                <option value="">Tất Cả</option>
                <option value="manager">Quản Lý</option>
                <option value="kitchen">Nhân Viên Bếp</option>
                <option value="service">Phục Vụ</option>
                <option value="staff">Nhân Viên</option>
            </select>
        </label>
    </section>

    <section class="employee-table-card">
        <div class="employee-table-toolbar">
            <button class="employee-export-button" type="button" data-export-employees>
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M12 3v12M8 11l4 4 4-4M4 19h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                Xuất CSV
            </button>

            <div class="employee-column-menu">
                <button class="employee-column-button" type="button" data-column-menu-trigger aria-expanded="false">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M4 7h16M7 12h10M10 17h4M6 5v4M18 15v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    </svg>
                    Cột hiển thị
                </button>
                <div class="employee-column-dropdown" data-column-menu hidden>
                    <label><input type="checkbox" data-column-toggle="contact" checked /> Liên hệ</label>
                    <label><input type="checkbox" data-column-toggle="date" checked /> Ngày vào làm</label>
                    <label><input type="checkbox" data-column-toggle="salary" checked /> Lương</label>
                    <label><input type="checkbox" data-column-toggle="account" checked /> Tài khoản</label>
                    <label><input type="checkbox" data-column-toggle="password" checked /> Mật khẩu</label>
                </div>
            </div>
        </div>

        <div class="employee-table-wrap">
            <table class="employee-table" data-employees-table>
                <thead>
                    <tr>
                        <th data-column="employee">Nhân Viên</th>
                        <th data-column="role">Chức Vụ</th>
                        <th data-column="contact">Liên Hệ</th>
                        <th data-column="date">Ngày Vào Làm</th>
                        <th class="is-right" data-column="salary">Lương</th>
                        <th data-column="account">Tên Tài Khoản</th>
                        <th data-column="password">Mật Khẩu</th>
                        <th data-column="status">Trạng Thái</th>
                        <th class="is-right" data-column="actions">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Employees)
                    {
                        <tr data-employee-row data-employee-id="@item.EmployeeId" data-search="@item.SearchText" data-role="@item.RoleKey">
                            <td data-column="employee" data-label="Nhân Viên">
                                <div class="employee-profile">
                                    <span class="employee-avatar" data-employee-initial>@item.Initial</span>
                                    <span class="employee-profile__copy">
                                        <strong data-employee-name>@item.EmployeeName</strong>
                                        <small data-employee-address>@item.Address</small>
                                    </span>
                                </div>
                            </td>
                            <td data-column="role" data-label="Chức Vụ">
                                <span class="role-pill @item.RoleCssClass" data-employee-role>@item.RoleLabel</span>
                            </td>
                            <td data-column="contact" data-label="Liên Hệ">
                                <div class="employee-contact">
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6.4 6.4l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                        <span data-employee-phone>@item.Phone</span>
                                    </span>
                                    <span>
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"></rect>
                                            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                        <span data-employee-email>@item.Email</span>
                                    </span>
                                </div>
                            </td>
                            <td data-column="date" data-label="Ngày Vào Làm" class="employee-date">@FormatDate(item.StartDate)</td>
                            <td data-column="salary" data-label="Lương" class="is-right">
                                <strong class="employee-salary">@FormatCurrency(item.Salary)</strong>
                            </td>
                            <td data-column="account" data-label="Tên Tài Khoản">@item.Account</td>
                            <td data-column="password" data-label="Mật Khẩu">
                                <span class="employee-password">@item.PasswordMask</span>
                            </td>
                            <td data-column="status" data-label="Trạng Thái">
                                <span class="employee-status @item.StatusCssClass">@item.StatusLabel</span>
                            </td>
                            <td data-column="actions" class="is-right" data-label="Hành Động">
                                <div class="employee-actions">
                                    <button class="employee-icon-action is-view" type="button" data-employee-action="view" data-employee-detail-url="@Url.Action("DetailsData", "NhanViens", new { id = item.EmployeeId })" aria-label="Xem chi tiết">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z" stroke="currentColor" stroke-width="2"></path>
                                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"></circle>
                                        </svg>
                                    </button>
                                    <button class="employee-icon-action is-edit" type="button" data-employee-action="edit" data-employee-detail-url="@Url.Action("DetailsData", "NhanViens", new { id = item.EmployeeId })" data-employee-update-url="@Url.Action("UpdateFromModal", "NhanViens")" aria-label="Chỉnh sửa">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                    </button>
                                    <button class="employee-icon-action is-delete" type="button" data-employee-action="delete" data-employee-detail-url="@Url.Action("DetailsData", "NhanViens", new { id = item.EmployeeId })" data-employee-delete-url="@Url.Action("DeleteFromModal", "NhanViens", new { id = item.EmployeeId })" aria-label="Xóa">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M3 6h18M8 6V4h8v2M10 11v6M14 11v6M6 6l1 15h10l1-15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr class="employee-empty-row" data-empty-row hidden>
                        <td colspan="9">Không tìm thấy nhân viên phù hợp với bộ lọc hiện tại.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="employee-modal" id="employee-modal" hidden aria-hidden="true">
    <button class="employee-modal__backdrop" type="button" data-employee-modal-close aria-label="Đóng modal"></button>

    <section class="employee-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="employee-modal-title">
        <button class="employee-modal__close" type="button" data-employee-modal-close aria-label="Đóng">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
        </button>

        <header class="employee-modal__header">
            <span class="employee-modal__avatar" data-modal-initial>NV</span>
            <div>
                <span class="employee-modal__eyebrow" data-modal-mode>Chi tiết nhân viên</span>
                <h2 id="employee-modal-title" data-modal-title>Thông tin nhân viên</h2>
                <p data-modal-subtitle>Đang tải dữ liệu nhân viên...</p>
            </div>
        </header>

        <div class="employee-modal__loading" data-modal-loading>
            <span class="employee-modal__spinner"></span>
            <span>Đang tải thông tin...</span>
        </div>

        <div class="employee-modal__error" data-modal-error hidden></div>

        <div class="employee-modal__view" data-modal-view hidden>
            <div class="employee-detail-grid">
                <article>
                    <span>Chức vụ</span>
                    <strong data-view-role>Nhân viên</strong>
                </article>
                <article>
                    <span>Trạng thái</span>
                    <strong data-view-status>Đang làm</strong>
                </article>
                <article>
                    <span>Ngày vào làm</span>
                    <strong data-view-date>Chưa cập nhật</strong>
                </article>
                <article>
                    <span>Lương</span>
                    <strong data-view-salary>0đ</strong>
                </article>
            </div>

            <div class="employee-detail-list">
                <div>
                    <span>Liên hệ</span>
                    <strong data-view-phone>Chưa có SĐT</strong>
                    <small data-view-email>Chưa có email</small>
                </div>
                <div>
                    <span>Địa chỉ</span>
                    <strong data-view-address>Chưa cập nhật địa chỉ</strong>
                </div>
                <div>
                    <span>Tài khoản</span>
                    <strong data-view-account>admin</strong>
                </div>
            </div>
        </div>

        <form class="employee-modal__form" data-modal-edit hidden>
            <input type="hidden" name="EmployeeId" data-edit-id />

            <div class="employee-form-grid">
                <label>
                    <span>Tên nhân viên</span>
                    <input type="text" name="EmployeeName" data-edit-name required />
                </label>
                <label>
                    <span>Ngày vào làm</span>
                    <input type="date" name="StartDate" data-edit-date />
                </label>
                <label>
                    <span>Chức vụ</span>
                    <select name="RoleId" data-edit-role></select>
                </label>
                <label>
                    <span>Hệ số lương</span>
                    <input type="number" name="SalaryCoefficient" data-edit-salary min="0" step="0.1" />
                </label>
                <label>
                    <span>Tài khoản</span>
                    <input type="text" name="Account" data-edit-account required />
                </label>
                <label>
                    <span>Mật khẩu</span>
                    <input type="text" name="Password" data-edit-password />
                </label>
                <label class="is-full">
                    <span>Địa chỉ</span>
                    <input type="text" name="Address" data-edit-address />
                </label>
            </div>

            <div class="employee-modal__actions">
                <button class="employee-modal__secondary" type="button" data-employee-modal-close>Hủy</button>
                <button class="employee-modal__primary" type="submit" data-edit-submit>Lưu thay đổi</button>
            </div>
        </form>

        <div class="employee-modal__delete" data-modal-delete hidden>
            <div class="employee-delete-warning">
                <span class="employee-delete-warning__icon">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M3 6h18M8 6V4h8v2M10 11v6M14 11v6M6 6l1 15h10l1-15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </span>
                <h3>Xóa nhân viên này?</h3>
                <p>Nhân viên sẽ được ẩn khỏi danh sách bằng cách xóa mềm. Dữ liệu liên quan vẫn được giữ trong hệ thống.</p>
            </div>

            <div class="employee-modal__actions">
                <button class="employee-modal__secondary" type="button" data-employee-modal-close>Hủy</button>
                <button class="employee-modal__danger" type="button" data-delete-submit>Xác nhận xóa</button>
            </div>
        </div>
    </section>
</div>

@section Scripts
{
    <script src="~/assets/js/admin-employees.js" asp-append-version="true"></script>
}

