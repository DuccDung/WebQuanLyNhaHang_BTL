@model IReadOnlyList<WebQuanLyNhaHang.Models.CuaHang>
@{
    Layout = "_CloudyCafeLayout";
    ViewData["Title"] = "Cửa Hàng - Cloudy Café";
    ViewData["ActiveNav"] = "CuaHang";

    string StoreImage(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=400";
        }

        var value = path.Trim();
        return value.StartsWith("http", StringComparison.OrdinalIgnoreCase) || value.StartsWith("/")
            ? value
            : $"/{value}";
    }

    string OpeningHours(WebQuanLyNhaHang.Models.CuaHang store)
    {
        if (!store.GioMoCua.HasValue || !store.GioDongCua.HasValue)
        {
            return "Đang cập nhật";
        }

        return $"{store.GioMoCua:HH\\:mm} - {store.GioDongCua:HH\\:mm}";
    }
}

<section class="store-hero">
    <div class="container">
        <h1>Cửa hàng <span>Cloudy Café</span></h1>
        <div class="accent-line"></div>
        <p class="muted store-subtitle">Các cửa hàng Cloudy Café sẵn sàng phục vụ bạn mỗi ngày.</p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <h2>Chưa có cửa hàng hiển thị</h2>
                <p>Dữ liệu cửa hàng sẽ được cập nhật trong khu vực quản trị.</p>
            </div>
        }
        else
        {
            <div class="store-grid">
                @foreach (var store in Model)
                {
                    <article class="store-card">
                        <img src="@StoreImage(store.PathPhoto)" alt="@store.TenCuaHang" loading="lazy">
                        <div class="store-body">
                            <h3>@store.TenCuaHang</h3>
                            <div class="info-stack">
                                <div class="info-row">
                                    <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    <span>@store.DiaChi</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(store.SoDienThoai))
                                {
                                    <div class="info-row">
                                        <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"></path></svg>
                                        <a href="tel:@store.SoDienThoai">@store.SoDienThoai</a>
                                    </div>
                                }
                                <div class="info-row">
                                    <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                                    <span>@OpeningHours(store)</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(store.GoogleMapUrl))
                            {
                                <a class="btn light full" href="@store.GoogleMapUrl" target="_blank" rel="noreferrer">Chỉ đường</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="content-section contact-band">
    <div class="container contact-inner">
        <h2>Không tìm thấy cửa hàng gần bạn?</h2>
        <p class="muted">Hãy liên hệ với chúng tôi để biết thêm thông tin về các cửa hàng mới.</p>
        <a class="btn" href="tel:18006936">Liên hệ: 1800.6936</a>
    </div>
</section>
