@model IReadOnlyList<WebQuanLyNhaHang.Models.BaiVietChuyenNha>
@{
    Layout = "_CloudyCafeLayout";
    ViewData["Title"] = "Chuyện Nhà - Cloudy Café";
    ViewData["ActiveNav"] = "ChuyenNha";

    string PostImage(WebQuanLyNhaHang.Models.BaiVietChuyenNha post)
    {
        if (string.IsNullOrWhiteSpace(post.PathPhoto))
        {
            return "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600";
        }

        var value = post.PathPhoto.Trim();
        return value.StartsWith("http", StringComparison.OrdinalIgnoreCase) || value.StartsWith("/")
            ? value
            : $"/{value}";
    }
}

<section class="store-hero">
    <div class="container">
        <h1>Chuyện nhà <span>Cloudy Café</span></h1>
        <div class="accent-line"></div>
        <p class="muted store-subtitle">Những câu chuyện nhỏ phía sau hương cà phê, lá trà và không gian gặp gỡ mỗi ngày.</p>
    </div>
</section>

<section class="content-section story-band">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <h2>Chưa có bài viết hiển thị</h2>
                <p>Dữ liệu Chuyện nhà sẽ được cập nhật trong khu vực quản trị.</p>
            </div>
        }
        else
        {
            <div class="blog-grid">
                @foreach (var post in Model)
                {
                    <article class="blog-card">
                        <img src="@PostImage(post)" alt="@(string.IsNullOrWhiteSpace(post.AltText) ? post.TieuDe : post.AltText)" loading="lazy">
                        <div class="blog-card-body">
                            <h3>@post.TieuDe</h3>
                            @if (!string.IsNullOrWhiteSpace(post.TomTat))
                            {
                                <p>@post.TomTat</p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="content-section special-band">
    <div class="container special-layout">
        <div class="special-image">
            <img src="https://images.unsplash.com/photo-1559925393-8be0ec4767c8?w=900" alt="Góc quầy Cloudy Café">
        </div>
        <div class="special-copy">
            <p class="script-title">Cloudy</p>
            <h2 class="block-title">Từ Nhà</h2>
            <p class="muted">Những món quen được chăm chút như một thói quen tốt trong ngày.</p>
            <p class="muted">Nội dung trên trang này hiện đã sẵn sàng lấy từ cơ sở dữ liệu để đội ngũ quản trị cập nhật linh hoạt.</p>
            <a class="btn green-btn" href="/TrangChu/Menu">Xem menu</a>
        </div>
    </div>
</section>
