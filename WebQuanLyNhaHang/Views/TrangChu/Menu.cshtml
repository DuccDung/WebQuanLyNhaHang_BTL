@using System.Text.Encodings.Web
@using System.Text.Json
@model WebQuanLyNhaHang.ViewModel.TrangChuMenuPageViewModel
@{
    Layout = "_CloudyCafeLayout";
    ViewData["Title"] = Model.Title;

    string ProductImage(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=400";
        }

        return path.StartsWith("http", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/")
            ? path
            : $"/{path}";
    }

    var allProducts = Model.ProductsByCategory.Values
        .SelectMany(products => products)
        .GroupBy(product => product.ProductId)
        .Select(group => group.First())
        .ToList();

    var productModalData = allProducts.Select(product =>
    {
        var conditions = product.ProductConditions
            .Where(condition => !condition.Remove && !string.IsNullOrWhiteSpace(condition.Condition))
            .Select(condition => condition.Condition!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(condition => condition.Equals("Đá", StringComparison.OrdinalIgnoreCase) ? 0 :
                condition.Equals("Nóng", StringComparison.OrdinalIgnoreCase) ? 1 : 2)
            .ToList();

        if (conditions.Count == 0)
        {
            conditions.AddRange(new[] { "Đá", "Nóng" });
        }

        return new
        {
            id = product.ProductId,
            name = product.TenSanPham ?? "Sản phẩm",
            description = product.MoTa ?? "Thức uống được chuẩn bị theo lựa chọn của bạn.",
            price = product.GiaTien ?? 0,
            image = ProductImage(product.PathPhoto),
            conditions
        };
    });

    var productModalJson = JsonSerializer.Serialize(productModalData, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
    ViewData["ProductModalJson"] = productModalJson;
}

<div class="container page-pad">
    <div class="layout-two">
        <aside class="sidebar">
            <h2>Danh mục</h2>
            @if (Model.Categories.Any())
            {
                <ul class="category-list">
                    @foreach (var category in Model.Categories)
                    {
                        var products = Model.ProductsByCategory.TryGetValue(category.CateId, out var items)
                            ? items
                            : Array.Empty<WebQuanLyNhaHang.Models.Product>();

                        <li>
                            <a class="category-button" href="#category-@category.CateId" data-category-link="category-@category.CateId">
                                <span>@category.TenLoaiSanPham</span>
                                <span class="count-pill">@products.Count</span>
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">Chưa có danh mục phù hợp.</p>
            }
        </aside>

        <section>
            @if (!Model.Categories.Any())
            {
                <div class="empty-state">
                    <h2>Chưa có sản phẩm</h2>
                    <p>Dữ liệu phần này chưa có trong hệ thống, Cloudy Café sẽ cập nhật thêm sau.</p>
                    <a class="btn" href="/TrangChu/Menu">Xem toàn bộ menu</a>
                </div>
            }
            else
            {
                @foreach (var category in Model.Categories)
                {
                    var products = Model.ProductsByCategory.TryGetValue(category.CateId, out var items)
                        ? items
                        : Array.Empty<WebQuanLyNhaHang.Models.Product>();

                    <section class="product-section" id="category-@category.CateId">
                        <div class="product-section-head">
                            <div>
                                <h2>@category.TenLoaiSanPham</h2>
                            </div>
                        </div>

                        <div class="product-grid">
                            @for (var index = 0; index < products.Count; index++)
                            {
                                var product = products[index];
                                <article class="product-card js-product-card" id="product-@product.ProductId" data-product-id="@product.ProductId" role="button" tabindex="0" aria-label="Xem @product.TenSanPham">
                                    @if (index == 0)
                                    {
                                        <span class="new-badge">New</span>
                                    }
                                    <div class="product-image">
                                        <img src="@ProductImage(product.PathPhoto)" alt="@product.TenSanPham" loading="lazy">
                                    </div>
                                    <div class="product-body">
                                        <h3 class="product-name">
                                            <button class="product-name-button js-open-product-modal" type="button" data-product-id="@product.ProductId">@product.TenSanPham</button>
                                        </h3>
                                        <div class="product-bottom">
                                            <span class="price">@String.Format("{0:N0}", product.GiaTien)đ</span>
                                            <button class="btn square js-open-product-modal" type="button" data-product-id="@product.ProductId" aria-label="Đặt @product.TenSanPham">
                                                <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoryLinks = Array.from(document.querySelectorAll("[data-category-link]"));
            const sections = Array.from(document.querySelectorAll(".product-section[id]"));

            function setActiveCategory(sectionId) {
                categoryLinks.forEach(function (link) {
                    link.classList.toggle("active", link.dataset.categoryLink === sectionId);
                });
            }

            if (categoryLinks.length > 0) {
                setActiveCategory(categoryLinks[0].dataset.categoryLink);
            }

            categoryLinks.forEach(function (link) {
                link.addEventListener("click", function () {
                    setActiveCategory(link.dataset.categoryLink);
                });
            });

            const observer = new IntersectionObserver(function (entries) {
                const visibleEntries = entries
                    .filter(function (entry) { return entry.isIntersecting; })
                    .sort(function (a, b) {
                        return Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top);
                    });

                if (visibleEntries.length > 0) {
                    setActiveCategory(visibleEntries[0].target.id);
                }
            }, {
                rootMargin: "-140px 0px -55% 0px",
                threshold: 0.01
            });

            sections.forEach(function (section) {
                observer.observe(section);
            });
        });
    </script>
}
