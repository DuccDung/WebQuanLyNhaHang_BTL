@using System.Text.Encodings.Web
@using System.Text.Json
@model IReadOnlyList<WebQuanLyNhaHang.Models.Product>
@{
    Layout = "_CloudyCafeLayout";
    ViewData["Title"] = "Cloudy Café";

    var featuredProducts = Model ?? Array.Empty<WebQuanLyNhaHang.Models.Product>();
    string ProductImage(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=400";
        }

        return path.StartsWith("http", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/")
            ? path
            : $"/{path}";
    }

    var productModalData = featuredProducts.Select(product =>
    {
        var conditions = product.ProductConditions
            .Where(condition => !condition.Remove && !string.IsNullOrWhiteSpace(condition.Condition))
            .Select(condition => condition.Condition!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(condition => condition.Equals("Đá", StringComparison.OrdinalIgnoreCase) ? 0 :
                condition.Equals("Nóng", StringComparison.OrdinalIgnoreCase) ? 1 : 2)
            .ToList();

        if (conditions.Count == 0)
        {
            conditions.AddRange(new[] { "Đá", "Nóng" });
        }

        return new
        {
            id = product.ProductId,
            name = product.TenSanPham ?? "Sản phẩm",
            description = product.MoTa ?? "Thức uống được chuẩn bị theo lựa chọn của bạn.",
            price = product.GiaTien ?? 0,
            image = ProductImage(product.PathPhoto),
            conditions
        };
    });

    var productModalJson = JsonSerializer.Serialize(productModalData, new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
}

<section class="hero">
    <img src="https://images.unsplash.com/photo-1702748580634-29a3969e9274?crop=entropy&amp;cs=tinysrgb&amp;fit=max&amp;fm=jpg&amp;q=80&amp;w=1400" alt="Cà phê và bánh sừng bò buổi sáng">
    <div class="hero-content">
        <div class="container hero-copy">
            <h1>Bắt đầu<br>ngày mới</h1>
            <h2>Tràn đầy<br>năng lượng</h2>
            <p>Thưởng thức ly cà phê đậm đà cùng chiếc bánh sừng bò giòn rụm trong không gian buổi sáng ấm áp tại Cloudy Café.</p>
            <div class="hero-actions">
                <a class="btn" href="/TrangChu/Menu">Đặt hàng ngay</a>
                <a class="btn white" href="/TrangChu/CuaHang">Tìm cửa hàng</a>
            </div>
        </div>
    </div>
</section>

<section class="content-section large">
    <div class="container">
        <div class="section-title">
            <h2>Sản phẩm nổi bật</h2>
            <div class="accent-line"></div>
            <p>Thử ngay những món ngon được nhiều người yêu thích nhất tại Cloudy Café</p>
        </div>

        <div class="product-grid">
            @foreach (var product in featuredProducts)
            {
                <article class="product-card js-product-card" data-product-id="@product.ProductId">
                    @if (product == featuredProducts.FirstOrDefault())
                    {
                        <span class="new-badge">Hot</span>
                    }
                    <div class="product-image">
                        <img src="@ProductImage(product.PathPhoto)" alt="@product.TenSanPham" loading="lazy">
                    </div>
                    <div class="product-body">
                        <h3 class="product-name">
                            <button class="product-name-button js-open-product-modal" type="button" data-product-id="@product.ProductId">@product.TenSanPham</button>
                        </h3>
                        <div class="product-bottom">
                            <span class="price">@String.Format("{0:N0}", product.GiaTien)đ</span>
                            <button class="btn square js-open-product-modal" type="button" data-product-id="@product.ProductId" aria-label="Đặt @product.TenSanPham">
                                <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="center-actions">
            <a class="btn outline" href="/TrangChu/Menu">Xem Tất Cả Menu</a>
        </div>
    </div>
</section>

<section class="content-section special-band">
    <div class="container special-layout">
        <div class="special-image">
            <img src="https://images.unsplash.com/photo-1708572727896-117b5ea25a86?crop=entropy&amp;cs=tinysrgb&amp;fit=max&amp;fm=jpg&amp;q=80&amp;w=1080" alt="Trà xanh Tây Bắc">
        </div>
        <div class="special-copy">
            <p class="script-title">Trà xanh</p>
            <h2 class="block-title">Tây Bắc</h2>
            <p class="muted">Vị mộc từ nhà, chở khách miền xuôi</p>
            <p class="muted">Được trồng trọt và chăm chút kỹ lưỡng, nuôi dưỡng từ thổ nhưỡng phì nhiêu, nguồn nước mát lành, bao bọc bởi mây và sương cùng nền nhiệt độ mát mẻ quanh năm.</p>
            <a class="btn green-btn" href="/TrangChu/DoUong">Thử ngay</a>
        </div>
    </div>
</section>

<section id="chuyen-nha" class="content-section story-band">
    <div class="container">
        <div class="section-title">
            <h2>Chuyện nhà</h2>
            <div class="accent-line"></div>
        </div>

        <div class="blog-grid">
            <a class="blog-card" href="/TrangChu/ChuyenNha">
                <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600" alt="Câu chuyện về ly cà phê sáng" loading="lazy">
                <div class="blog-card-body">
                    <h3>Câu chuyện về ly cà phê sáng</h3>
                    <p>Mỗi buổi sáng đều là một khởi đầu mới, và không gì tuyệt vời hơn việc bắt đầu ngày mới với một ly cà phê thơm ngon từ Cloudy Café.</p>
                </div>
            </a>
            <a class="blog-card" href="/TrangChu/ChuyenNha">
                <img src="https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=600" alt="Hành trình tìm kiếm hạt cà phê hoàn hảo" loading="lazy">
                <div class="blog-card-body">
                    <h3>Hành trình tìm kiếm hạt cà phê hoàn hảo</h3>
                    <p>Chúng tôi đi khắp các vùng cao nguyên Tây Bắc để tìm kiếm những hạt cà phê thượng hạng nhất, mang đến cho bạn trải nghiệm tuyệt vời nhất.</p>
                </div>
            </a>
            <a class="blog-card" href="/TrangChu/ChuyenNha">
                <img src="https://images.unsplash.com/photo-1564890369478-c89ca6d9cde9?w=600" alt="Bí mật của ly trà xanh Tây Bắc" loading="lazy">
                <div class="blog-card-body">
                    <h3>Bí mật của ly trà xanh Tây Bắc</h3>
                    <p>Trà xanh Tây Bắc không chỉ là thức uống, mà còn là tinh hoa của đất trời, được chăm sóc kỹ lưỡng từ những người nông dân tận tâm.</p>
                </div>
            </a>
            <a class="blog-card" href="/TrangChu/ChuyenNha">
                <img src="https://images.unsplash.com/photo-1511920170033-f8396924c348?w=600" alt="Không gian Cloudy Café" loading="lazy">
                <div class="blog-card-body">
                    <h3>Không gian Cloudy Café - Nơi gặp gỡ và sáng tạo</h3>
                    <p>Với thiết kế ấm cúng và không gian thoáng đãng, Cloudy Café là điểm đến lý tưởng cho những cuộc gặp gỡ bạn bè hay làm việc sáng tạo.</p>
                </div>
            </a>
        </div>
    </div>
</section>
